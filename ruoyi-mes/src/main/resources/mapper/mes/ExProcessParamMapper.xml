<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.ex.mapper.ExProcessParamMapper">

    <resultMap type="ExProcessParam" id="ExProcessParamResult">
        <id     property="id"    column="id"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="operationTaskId"    column="operation_task_id"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="equipmentId"    column="equipment_id"    />
        <result property="paramName"    column="param_name"    />
        <result property="paramValue"    column="param_value"    />
        <result property="paramUnit"    column="param_unit"    />
        <result property="lowerLimit"    column="lower_limit"    />
        <result property="upperLimit"    column="upper_limit"    />
        <result property="result"    column="result"    />
        <result property="collectedAt"    column="collected_at"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectExProcessParamVo">
        select id, production_order_id, operation_task_id, serial_no, equipment_id, param_name, param_value, param_unit, lower_limit, upper_limit, result, collected_at, create_by, create_time, update_by, update_time, remark from ex_process_param
    </sql>

    <select id="selectExProcessParamList" parameterType="ExProcessParam" resultMap="ExProcessParamResult">
        <include refid="selectExProcessParamVo"/>
        <where>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="operationTaskId != null and operationTaskId != ''">
                AND operation_task_id = #{operationTaskId}
            </if>
            <if test="serialNo != null and serialNo != ''">
                AND serial_no like concat('%', #{serialNo}, '%')
            </if>
            <if test="equipmentId != null and equipmentId != ''">
                AND equipment_id = #{equipmentId}
            </if>
            <if test="paramName != null and paramName != ''">
                AND param_name like concat('%', #{paramName}, '%')
            </if>
            <if test="result != null and result != ''">
                AND result = #{result}
            </if>
        </where>
    </select>

    <select id="selectExProcessParamById" parameterType="Long" resultMap="ExProcessParamResult">
        <include refid="selectExProcessParamVo"/>
        where id = #{id}
    </select>

    <insert id="insertExProcessParam" parameterType="ExProcessParam" useGeneratedKeys="true" keyProperty="id">
        insert into ex_process_param(
            production_order_id,
            operation_task_id,
            serial_no,
            equipment_id,
            param_name,
            param_value,
            param_unit,
            lower_limit,
            upper_limit,
            result,
            collected_at,
            create_by, create_time
        )values(
            #{productionOrderId},
            #{operationTaskId},
            #{serialNo},
            #{equipmentId},
            #{paramName},
            #{paramValue},
            #{paramUnit},
            #{lowerLimit},
            #{upperLimit},
            #{result},
            #{collectedAt},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateExProcessParam" parameterType="ExProcessParam">
        update ex_process_param
        <set>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="operationTaskId != null">operation_task_id = #{operationTaskId},</if>
            <if test="serialNo != null">serial_no = #{serialNo},</if>
            <if test="equipmentId != null">equipment_id = #{equipmentId},</if>
            <if test="paramName != null">param_name = #{paramName},</if>
            <if test="paramValue != null">param_value = #{paramValue},</if>
            <if test="paramUnit != null">param_unit = #{paramUnit},</if>
            <if test="lowerLimit != null">lower_limit = #{lowerLimit},</if>
            <if test="upperLimit != null">upper_limit = #{upperLimit},</if>
            <if test="result != null">result = #{result},</if>
            <if test="collectedAt != null">collected_at = #{collectedAt},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteExProcessParamById" parameterType="Long">
        delete from ex_process_param where id = #{id}
    </delete>

    <delete id="deleteExProcessParamByIds" parameterType="Long">
        delete from ex_process_param where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
