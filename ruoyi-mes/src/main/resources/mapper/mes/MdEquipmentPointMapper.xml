<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdEquipmentPointMapper">

    <resultMap type="MdEquipmentPoint" id="MdEquipmentPointResult">
        <id     property="id"    column="id"    />
        <result property="equipmentId"    column="equipment_id"    />
        <result property="pointCode"    column="point_code"    />
        <result property="pointName"    column="point_name"    />
        <result property="protocol"    column="protocol"    />
        <result property="address"    column="address"    />
        <result property="dataType"    column="data_type"    />
        <result property="unit"    column="unit"    />
        <result property="changeReason"    column="change_reason"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdEquipmentPointVo">
        select id, equipment_id, point_code, point_name, protocol, address, data_type, unit, change_reason, create_by, create_time, update_by, update_time, remark from md_equipment_point
    </sql>

    <select id="selectMdEquipmentPointList" parameterType="MdEquipmentPoint" resultMap="MdEquipmentPointResult">
        <include refid="selectMdEquipmentPointVo"/>
        <where>
            <if test="equipmentId != null and equipmentId != ''">
                AND equipment_id = #{equipmentId}
            </if>
            <if test="pointCode != null and pointCode != ''">
                AND point_code like concat('%', #{pointCode}, '%')
            </if>
            <if test="pointName != null and pointName != ''">
                AND point_name like concat('%', #{pointName}, '%')
            </if>
        </where>
    </select>

    <select id="selectMdEquipmentPointById" parameterType="Long" resultMap="MdEquipmentPointResult">
        <include refid="selectMdEquipmentPointVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdEquipmentPoint" parameterType="MdEquipmentPoint" useGeneratedKeys="true" keyProperty="id">
        insert into md_equipment_point(
            equipment_id,
            point_code,
            point_name,
            protocol,
            address,
            data_type,
            unit,
            change_reason,
            create_by, create_time
        )values(
            #{equipmentId},
            #{pointCode},
            #{pointName},
            #{protocol},
            #{address},
            #{dataType},
            #{unit},
            #{changeReason},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdEquipmentPoint" parameterType="MdEquipmentPoint">
        update md_equipment_point
        <set>
            <if test="equipmentId != null">equipment_id = #{equipmentId},</if>
            <if test="pointCode != null">point_code = #{pointCode},</if>
            <if test="pointName != null">point_name = #{pointName},</if>
            <if test="protocol != null">protocol = #{protocol},</if>
            <if test="address != null">address = #{address},</if>
            <if test="dataType != null">data_type = #{dataType},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="changeReason != null">change_reason = #{changeReason},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdEquipmentPointById" parameterType="Long">
        delete from md_equipment_point where id = #{id}
    </delete>

    <delete id="deleteMdEquipmentPointByIds" parameterType="Long">
        delete from md_equipment_point where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
