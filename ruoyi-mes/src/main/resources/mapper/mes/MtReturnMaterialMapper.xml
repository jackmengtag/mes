<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.mt.mapper.MtReturnMaterialMapper">

    <resultMap type="MtReturnMaterial" id="MtReturnMaterialResult">
        <id     property="id"    column="id"    />
        <result property="returnNo"    column="return_no"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="materialId"    column="material_id"    />
        <result property="materialCode"    column="material_code"    />
        <result property="materialBatchNo"    column="material_batch_no"    />
        <result property="originPickingNo"    column="origin_picking_no"    />
        <result property="returnQty"    column="return_qty"    />
        <result property="reason"    column="reason"    />
        <result property="warehouseConfirmStatus"    column="warehouse_confirm_status"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMtReturnMaterialVo">
        select id, return_no, production_order_id, order_no, material_id, material_code, material_batch_no, origin_picking_no, return_qty, reason, warehouse_confirm_status, status, create_by, create_time, update_by, update_time, remark from mt_return_material
    </sql>

    <select id="selectMtReturnMaterialList" parameterType="MtReturnMaterial" resultMap="MtReturnMaterialResult">
        <include refid="selectMtReturnMaterialVo"/>
        <where>
            <if test="returnNo != null and returnNo != ''">
                AND return_no like concat('%', #{returnNo}, '%')
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="materialId != null and materialId != ''">
                AND material_id = #{materialId}
            </if>
            <if test="materialCode != null and materialCode != ''">
                AND material_code like concat('%', #{materialCode}, '%')
            </if>
            <if test="materialBatchNo != null and materialBatchNo != ''">
                AND material_batch_no like concat('%', #{materialBatchNo}, '%')
            </if>
            <if test="warehouseConfirmStatus != null and warehouseConfirmStatus != ''">
                AND warehouse_confirm_status = #{warehouseConfirmStatus}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMtReturnMaterialById" parameterType="Long" resultMap="MtReturnMaterialResult">
        <include refid="selectMtReturnMaterialVo"/>
        where id = #{id}
    </select>

    <insert id="insertMtReturnMaterial" parameterType="MtReturnMaterial" useGeneratedKeys="true" keyProperty="id">
        insert into mt_return_material(
            return_no,
            production_order_id,
            order_no,
            material_id,
            material_code,
            material_batch_no,
            origin_picking_no,
            return_qty,
            reason,
            warehouse_confirm_status,
            status,
            create_by, create_time
        )values(
            #{returnNo},
            #{productionOrderId},
            #{orderNo},
            #{materialId},
            #{materialCode},
            #{materialBatchNo},
            #{originPickingNo},
            #{returnQty},
            #{reason},
            #{warehouseConfirmStatus},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMtReturnMaterial" parameterType="MtReturnMaterial">
        update mt_return_material
        <set>
            <if test="returnNo != null">return_no = #{returnNo},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="materialCode != null">material_code = #{materialCode},</if>
            <if test="materialBatchNo != null">material_batch_no = #{materialBatchNo},</if>
            <if test="originPickingNo != null">origin_picking_no = #{originPickingNo},</if>
            <if test="returnQty != null">return_qty = #{returnQty},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="warehouseConfirmStatus != null">warehouse_confirm_status = #{warehouseConfirmStatus},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMtReturnMaterialById" parameterType="Long">
        delete from mt_return_material where id = #{id}
    </delete>

    <delete id="deleteMtReturnMaterialByIds" parameterType="Long">
        delete from mt_return_material where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
