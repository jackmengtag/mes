<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.integration.mapper.IntMessageMapper">

    <resultMap type="IntMessage" id="IntMessageResult">
        <id     property="id"    column="id"    />
        <result property="messageId"    column="message_id"    />
        <result property="messageType"    column="message_type"    />
        <result property="messageVersion"    column="message_version"    />
        <result property="sourceSystem"    column="source_system"    />
        <result property="targetSystem"    column="target_system"    />
        <result property="plantCode"    column="plant_code"    />
        <result property="traceId"    column="trace_id"    />
        <result property="idempotencyKey"    column="idempotency_key"    />
        <result property="direction"    column="direction"    />
        <result property="payload"    column="payload"    />
        <result property="status"    column="status"    />
        <result property="retryCount"    column="retry_count"    />
        <result property="nextRetryTime"    column="next_retry_time"    />
        <result property="errorMsg"    column="error_msg"    />
        <result property="occurredAt"    column="occurred_at"    />
        <result property="processedAt"    column="processed_at"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectIntMessageVo">
        select id, message_id, message_type, message_version, source_system, target_system, plant_code, trace_id, idempotency_key, direction, payload, status, retry_count, next_retry_time, error_msg, occurred_at, processed_at, create_by, create_time, update_by, update_time, remark from int_message
    </sql>

    <select id="selectIntMessageList" parameterType="IntMessage" resultMap="IntMessageResult">
        <include refid="selectIntMessageVo"/>
        <where>
            <if test="messageId != null and messageId != ''">
                AND message_id like concat('%', #{messageId}, '%')
            </if>
            <if test="messageType != null and messageType != ''">
                AND message_type = #{messageType}
            </if>
            <if test="sourceSystem != null and sourceSystem != ''">
                AND source_system = #{sourceSystem}
            </if>
            <if test="targetSystem != null and targetSystem != ''">
                AND target_system = #{targetSystem}
            </if>
            <if test="plantCode != null and plantCode != ''">
                AND plant_code = #{plantCode}
            </if>
            <if test="idempotencyKey != null and idempotencyKey != ''">
                AND idempotency_key like concat('%', #{idempotencyKey}, '%')
            </if>
            <if test="direction != null and direction != ''">
                AND direction = #{direction}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectIntMessageById" parameterType="Long" resultMap="IntMessageResult">
        <include refid="selectIntMessageVo"/>
        where id = #{id}
    </select>

    <insert id="insertIntMessage" parameterType="IntMessage" useGeneratedKeys="true" keyProperty="id">
        insert into int_message(
            message_id,
            message_type,
            message_version,
            source_system,
            target_system,
            plant_code,
            trace_id,
            idempotency_key,
            direction,
            payload,
            status,
            retry_count,
            next_retry_time,
            error_msg,
            occurred_at,
            processed_at,
            create_by, create_time
        )values(
            #{messageId},
            #{messageType},
            #{messageVersion},
            #{sourceSystem},
            #{targetSystem},
            #{plantCode},
            #{traceId},
            #{idempotencyKey},
            #{direction},
            #{payload},
            #{status},
            #{retryCount},
            #{nextRetryTime},
            #{errorMsg},
            #{occurredAt},
            #{processedAt},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateIntMessage" parameterType="IntMessage">
        update int_message
        <set>
            <if test="messageId != null">message_id = #{messageId},</if>
            <if test="messageType != null">message_type = #{messageType},</if>
            <if test="messageVersion != null">message_version = #{messageVersion},</if>
            <if test="sourceSystem != null">source_system = #{sourceSystem},</if>
            <if test="targetSystem != null">target_system = #{targetSystem},</if>
            <if test="plantCode != null">plant_code = #{plantCode},</if>
            <if test="traceId != null">trace_id = #{traceId},</if>
            <if test="idempotencyKey != null">idempotency_key = #{idempotencyKey},</if>
            <if test="direction != null">direction = #{direction},</if>
            <if test="payload != null">payload = #{payload},</if>
            <if test="status != null">status = #{status},</if>
            <if test="retryCount != null">retry_count = #{retryCount},</if>
            <if test="nextRetryTime != null">next_retry_time = #{nextRetryTime},</if>
            <if test="errorMsg != null">error_msg = #{errorMsg},</if>
            <if test="occurredAt != null">occurred_at = #{occurredAt},</if>
            <if test="processedAt != null">processed_at = #{processedAt},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteIntMessageById" parameterType="Long">
        delete from int_message where id = #{id}
    </delete>

    <delete id="deleteIntMessageByIds" parameterType="Long">
        delete from int_message where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
