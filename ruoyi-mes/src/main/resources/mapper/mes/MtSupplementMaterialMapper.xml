<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.mt.mapper.MtSupplementMaterialMapper">

    <resultMap type="MtSupplementMaterial" id="MtSupplementMaterialResult">
        <id     property="id"    column="id"    />
        <result property="supplementNo"    column="supplement_no"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="materialId"    column="material_id"    />
        <result property="materialCode"    column="material_code"    />
        <result property="materialBatchNo"    column="material_batch_no"    />
        <result property="supplementQty"    column="supplement_qty"    />
        <result property="reason"    column="reason"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMtSupplementMaterialVo">
        select id, supplement_no, production_order_id, order_no, material_id, material_code, material_batch_no, supplement_qty, reason, status, create_by, create_time, update_by, update_time, remark from mt_supplement_material
    </sql>

    <select id="selectMtSupplementMaterialList" parameterType="MtSupplementMaterial" resultMap="MtSupplementMaterialResult">
        <include refid="selectMtSupplementMaterialVo"/>
        <where>
            <if test="supplementNo != null and supplementNo != ''">
                AND supplement_no like concat('%', #{supplementNo}, '%')
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="materialId != null and materialId != ''">
                AND material_id = #{materialId}
            </if>
            <if test="materialCode != null and materialCode != ''">
                AND material_code like concat('%', #{materialCode}, '%')
            </if>
            <if test="materialBatchNo != null and materialBatchNo != ''">
                AND material_batch_no like concat('%', #{materialBatchNo}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMtSupplementMaterialById" parameterType="Long" resultMap="MtSupplementMaterialResult">
        <include refid="selectMtSupplementMaterialVo"/>
        where id = #{id}
    </select>

    <insert id="insertMtSupplementMaterial" parameterType="MtSupplementMaterial" useGeneratedKeys="true" keyProperty="id">
        insert into mt_supplement_material(
            supplement_no,
            production_order_id,
            order_no,
            material_id,
            material_code,
            material_batch_no,
            supplement_qty,
            reason,
            status,
            create_by, create_time
        )values(
            #{supplementNo},
            #{productionOrderId},
            #{orderNo},
            #{materialId},
            #{materialCode},
            #{materialBatchNo},
            #{supplementQty},
            #{reason},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMtSupplementMaterial" parameterType="MtSupplementMaterial">
        update mt_supplement_material
        <set>
            <if test="supplementNo != null">supplement_no = #{supplementNo},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="materialCode != null">material_code = #{materialCode},</if>
            <if test="materialBatchNo != null">material_batch_no = #{materialBatchNo},</if>
            <if test="supplementQty != null">supplement_qty = #{supplementQty},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMtSupplementMaterialById" parameterType="Long">
        delete from mt_supplement_material where id = #{id}
    </delete>

    <delete id="deleteMtSupplementMaterialByIds" parameterType="Long">
        delete from mt_supplement_material where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
