<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.mt.mapper.MtMaterialRequirementMapper">

    <resultMap type="MtMaterialRequirement" id="MtMaterialRequirementResult">
        <id     property="id"    column="id"    />
        <result property="requirementNo"    column="requirement_no"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="materialId"    column="material_id"    />
        <result property="materialCode"    column="material_code"    />
        <result property="materialName"    column="material_name"    />
        <result property="unit"    column="unit"    />
        <result property="requiredQty"    column="required_qty"    />
        <result property="allocatedQty"    column="allocated_qty"    />
        <result property="pickedQty"    column="picked_qty"    />
        <result property="consumedQty"    column="consumed_qty"    />
        <result property="lackQty"    column="lack_qty"    />
        <result property="keyFlag"    column="key_flag"    />
        <result property="kitStatus"    column="kit_status"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMtMaterialRequirementVo">
        select id, requirement_no, production_order_id, order_no, operation_code, material_id, material_code, material_name, unit, required_qty, allocated_qty, picked_qty, consumed_qty, lack_qty, key_flag, kit_status, status, create_by, create_time, update_by, update_time, remark from mt_material_requirement
    </sql>

    <select id="selectMtMaterialRequirementList" parameterType="MtMaterialRequirement" resultMap="MtMaterialRequirementResult">
        <include refid="selectMtMaterialRequirementVo"/>
        <where>
            <if test="requirementNo != null and requirementNo != ''">
                AND requirement_no like concat('%', #{requirementNo}, '%')
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="operationCode != null and operationCode != ''">
                AND operation_code = #{operationCode}
            </if>
            <if test="materialId != null and materialId != ''">
                AND material_id = #{materialId}
            </if>
            <if test="materialCode != null and materialCode != ''">
                AND material_code like concat('%', #{materialCode}, '%')
            </if>
            <if test="materialName != null and materialName != ''">
                AND material_name like concat('%', #{materialName}, '%')
            </if>
            <if test="kitStatus != null and kitStatus != ''">
                AND kit_status = #{kitStatus}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMtMaterialRequirementById" parameterType="Long" resultMap="MtMaterialRequirementResult">
        <include refid="selectMtMaterialRequirementVo"/>
        where id = #{id}
    </select>

    <insert id="insertMtMaterialRequirement" parameterType="MtMaterialRequirement" useGeneratedKeys="true" keyProperty="id">
        insert into mt_material_requirement(
            requirement_no,
            production_order_id,
            order_no,
            operation_code,
            material_id,
            material_code,
            material_name,
            unit,
            required_qty,
            allocated_qty,
            picked_qty,
            consumed_qty,
            lack_qty,
            key_flag,
            kit_status,
            status,
            create_by, create_time
        )values(
            #{requirementNo},
            #{productionOrderId},
            #{orderNo},
            #{operationCode},
            #{materialId},
            #{materialCode},
            #{materialName},
            #{unit},
            #{requiredQty},
            #{allocatedQty},
            #{pickedQty},
            #{consumedQty},
            #{lackQty},
            #{keyFlag},
            #{kitStatus},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMtMaterialRequirement" parameterType="MtMaterialRequirement">
        update mt_material_requirement
        <set>
            <if test="requirementNo != null">requirement_no = #{requirementNo},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="materialCode != null">material_code = #{materialCode},</if>
            <if test="materialName != null">material_name = #{materialName},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="requiredQty != null">required_qty = #{requiredQty},</if>
            <if test="allocatedQty != null">allocated_qty = #{allocatedQty},</if>
            <if test="pickedQty != null">picked_qty = #{pickedQty},</if>
            <if test="consumedQty != null">consumed_qty = #{consumedQty},</if>
            <if test="lackQty != null">lack_qty = #{lackQty},</if>
            <if test="keyFlag != null">key_flag = #{keyFlag},</if>
            <if test="kitStatus != null">kit_status = #{kitStatus},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMtMaterialRequirementById" parameterType="Long">
        delete from mt_material_requirement where id = #{id}
    </delete>

    <delete id="deleteMtMaterialRequirementByIds" parameterType="Long">
        delete from mt_material_requirement where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
