<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.integration.mapper.IntDeadLetterMapper">

    <resultMap type="IntDeadLetter" id="IntDeadLetterResult">
        <id     property="id"    column="id"    />
        <result property="messageId"    column="message_id"    />
        <result property="bizType"    column="biz_type"    />
        <result property="payload"    column="payload"    />
        <result property="errorMsg"    column="error_msg"    />
        <result property="handler"    column="handler"    />
        <result property="handleStatus"    column="handle_status"    />
        <result property="failedAt"    column="failed_at"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectIntDeadLetterVo">
        select id, message_id, biz_type, payload, error_msg, handler, handle_status, failed_at, create_by, create_time, update_by, update_time, remark from int_dead_letter
    </sql>

    <select id="selectIntDeadLetterList" parameterType="IntDeadLetter" resultMap="IntDeadLetterResult">
        <include refid="selectIntDeadLetterVo"/>
        <where>
            <if test="messageId != null and messageId != ''">
                AND message_id like concat('%', #{messageId}, '%')
            </if>
            <if test="bizType != null and bizType != ''">
                AND biz_type = #{bizType}
            </if>
            <if test="handleStatus != null and handleStatus != ''">
                AND handle_status = #{handleStatus}
            </if>
        </where>
    </select>

    <select id="selectIntDeadLetterById" parameterType="Long" resultMap="IntDeadLetterResult">
        <include refid="selectIntDeadLetterVo"/>
        where id = #{id}
    </select>

    <insert id="insertIntDeadLetter" parameterType="IntDeadLetter" useGeneratedKeys="true" keyProperty="id">
        insert into int_dead_letter(
            message_id,
            biz_type,
            payload,
            error_msg,
            handler,
            handle_status,
            failed_at,
            create_by, create_time
        )values(
            #{messageId},
            #{bizType},
            #{payload},
            #{errorMsg},
            #{handler},
            #{handleStatus},
            #{failedAt},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateIntDeadLetter" parameterType="IntDeadLetter">
        update int_dead_letter
        <set>
            <if test="messageId != null">message_id = #{messageId},</if>
            <if test="bizType != null">biz_type = #{bizType},</if>
            <if test="payload != null">payload = #{payload},</if>
            <if test="errorMsg != null">error_msg = #{errorMsg},</if>
            <if test="handler != null">handler = #{handler},</if>
            <if test="handleStatus != null">handle_status = #{handleStatus},</if>
            <if test="failedAt != null">failed_at = #{failedAt},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteIntDeadLetterById" parameterType="Long">
        delete from int_dead_letter where id = #{id}
    </delete>

    <delete id="deleteIntDeadLetterByIds" parameterType="Long">
        delete from int_dead_letter where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
