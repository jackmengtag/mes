<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.wo.mapper.WoOperationTaskMapper">

    <resultMap type="WoOperationTask" id="WoOperationTaskResult">
        <id     property="id"    column="id"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="operationName"    column="operation_name"    />
        <result property="sequenceNo"    column="sequence_no"    />
        <result property="workCenterId"    column="work_center_id"    />
        <result property="requiredEquipmentType"    column="required_equipment_type"    />
        <result property="plannedQty"    column="planned_qty"    />
        <result property="completedQty"    column="completed_qty"    />
        <result property="qualifiedQty"    column="qualified_qty"    />
        <result property="unqualifiedQty"    column="unqualified_qty"    />
        <result property="scrapQty"    column="scrap_qty"    />
        <result property="forceInspect"    column="force_inspect"    />
        <result property="dispatchTeamId"    column="dispatch_team_id"    />
        <result property="operatorNo"    column="operator_no"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWoOperationTaskVo">
        select id, production_order_id, order_no, operation_code, operation_name, sequence_no, work_center_id, required_equipment_type, planned_qty, completed_qty, qualified_qty, unqualified_qty, scrap_qty, force_inspect, dispatch_team_id, operator_no, status, create_by, create_time, update_by, update_time, remark from wo_operation_task
    </sql>

    <select id="selectWoOperationTaskList" parameterType="WoOperationTask" resultMap="WoOperationTaskResult">
        <include refid="selectWoOperationTaskVo"/>
        <where>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="operationCode != null and operationCode != ''">
                AND operation_code like concat('%', #{operationCode}, '%')
            </if>
            <if test="operationName != null and operationName != ''">
                AND operation_name like concat('%', #{operationName}, '%')
            </if>
            <if test="workCenterId != null and workCenterId != ''">
                AND work_center_id = #{workCenterId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectWoOperationTaskById" parameterType="Long" resultMap="WoOperationTaskResult">
        <include refid="selectWoOperationTaskVo"/>
        where id = #{id}
    </select>

    <insert id="insertWoOperationTask" parameterType="WoOperationTask" useGeneratedKeys="true" keyProperty="id">
        insert into wo_operation_task(
            production_order_id,
            order_no,
            operation_code,
            operation_name,
            sequence_no,
            work_center_id,
            required_equipment_type,
            planned_qty,
            completed_qty,
            qualified_qty,
            unqualified_qty,
            scrap_qty,
            force_inspect,
            dispatch_team_id,
            operator_no,
            status,
            create_by, create_time
        )values(
            #{productionOrderId},
            #{orderNo},
            #{operationCode},
            #{operationName},
            #{sequenceNo},
            #{workCenterId},
            #{requiredEquipmentType},
            #{plannedQty},
            #{completedQty},
            #{qualifiedQty},
            #{unqualifiedQty},
            #{scrapQty},
            #{forceInspect},
            #{dispatchTeamId},
            #{operatorNo},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateWoOperationTask" parameterType="WoOperationTask">
        update wo_operation_task
        <set>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="operationName != null">operation_name = #{operationName},</if>
            <if test="sequenceNo != null">sequence_no = #{sequenceNo},</if>
            <if test="workCenterId != null">work_center_id = #{workCenterId},</if>
            <if test="requiredEquipmentType != null">required_equipment_type = #{requiredEquipmentType},</if>
            <if test="plannedQty != null">planned_qty = #{plannedQty},</if>
            <if test="completedQty != null">completed_qty = #{completedQty},</if>
            <if test="qualifiedQty != null">qualified_qty = #{qualifiedQty},</if>
            <if test="unqualifiedQty != null">unqualified_qty = #{unqualifiedQty},</if>
            <if test="scrapQty != null">scrap_qty = #{scrapQty},</if>
            <if test="forceInspect != null">force_inspect = #{forceInspect},</if>
            <if test="dispatchTeamId != null">dispatch_team_id = #{dispatchTeamId},</if>
            <if test="operatorNo != null">operator_no = #{operatorNo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteWoOperationTaskById" parameterType="Long">
        delete from wo_operation_task where id = #{id}
    </delete>

    <delete id="deleteWoOperationTaskByIds" parameterType="Long">
        delete from wo_operation_task where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
