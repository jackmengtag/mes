<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdEquipmentMapper">

    <resultMap type="MdEquipment" id="MdEquipmentResult">
        <id     property="id"    column="id"    />
        <result property="equipmentCode"    column="equipment_code"    />
        <result property="equipmentName"    column="equipment_name"    />
        <result property="equipmentType"    column="equipment_type"    />
        <result property="workCenterId"    column="work_center_id"    />
        <result property="collectMode"    column="collect_mode"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdEquipmentVo">
        select id, equipment_code, equipment_name, equipment_type, work_center_id, collect_mode, status, create_by, create_time, update_by, update_time, remark from md_equipment
    </sql>

    <select id="selectMdEquipmentList" parameterType="MdEquipment" resultMap="MdEquipmentResult">
        <include refid="selectMdEquipmentVo"/>
        <where>
            <if test="equipmentCode != null and equipmentCode != ''">
                AND equipment_code like concat('%', #{equipmentCode}, '%')
            </if>
            <if test="equipmentName != null and equipmentName != ''">
                AND equipment_name like concat('%', #{equipmentName}, '%')
            </if>
            <if test="equipmentType != null and equipmentType != ''">
                AND equipment_type = #{equipmentType}
            </if>
            <if test="workCenterId != null and workCenterId != ''">
                AND work_center_id = #{workCenterId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMdEquipmentById" parameterType="Long" resultMap="MdEquipmentResult">
        <include refid="selectMdEquipmentVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdEquipment" parameterType="MdEquipment" useGeneratedKeys="true" keyProperty="id">
        insert into md_equipment(
            equipment_code,
            equipment_name,
            equipment_type,
            work_center_id,
            collect_mode,
            status,
            create_by, create_time
        )values(
            #{equipmentCode},
            #{equipmentName},
            #{equipmentType},
            #{workCenterId},
            #{collectMode},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdEquipment" parameterType="MdEquipment">
        update md_equipment
        <set>
            <if test="equipmentCode != null">equipment_code = #{equipmentCode},</if>
            <if test="equipmentName != null">equipment_name = #{equipmentName},</if>
            <if test="equipmentType != null">equipment_type = #{equipmentType},</if>
            <if test="workCenterId != null">work_center_id = #{workCenterId},</if>
            <if test="collectMode != null">collect_mode = #{collectMode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdEquipmentById" parameterType="Long">
        delete from md_equipment where id = #{id}
    </delete>

    <delete id="deleteMdEquipmentByIds" parameterType="Long">
        delete from md_equipment where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
