<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.eq.mapper.EqStatusMapper">

    <resultMap type="EqStatus" id="EqStatusResult">
        <id     property="id"    column="id"    />
        <result property="equipmentId"    column="equipment_id"    />
        <result property="equipmentCode"    column="equipment_code"    />
        <result property="status"    column="status"    />
        <result property="changedAt"    column="changed_at"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectEqStatusVo">
        select id, equipment_id, equipment_code, status, changed_at, create_by, create_time, update_by, update_time, remark from eq_status
    </sql>

    <select id="selectEqStatusList" parameterType="EqStatus" resultMap="EqStatusResult">
        <include refid="selectEqStatusVo"/>
        <where>
            <if test="equipmentId != null and equipmentId != ''">
                AND equipment_id = #{equipmentId}
            </if>
            <if test="equipmentCode != null and equipmentCode != ''">
                AND equipment_code like concat('%', #{equipmentCode}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectEqStatusById" parameterType="Long" resultMap="EqStatusResult">
        <include refid="selectEqStatusVo"/>
        where id = #{id}
    </select>

    <insert id="insertEqStatus" parameterType="EqStatus" useGeneratedKeys="true" keyProperty="id">
        insert into eq_status(
            equipment_id,
            equipment_code,
            status,
            changed_at,
            create_by, create_time
        )values(
            #{equipmentId},
            #{equipmentCode},
            #{status},
            #{changedAt},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateEqStatus" parameterType="EqStatus">
        update eq_status
        <set>
            <if test="equipmentId != null">equipment_id = #{equipmentId},</if>
            <if test="equipmentCode != null">equipment_code = #{equipmentCode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="changedAt != null">changed_at = #{changedAt},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteEqStatusById" parameterType="Long">
        delete from eq_status where id = #{id}
    </delete>

    <delete id="deleteEqStatusByIds" parameterType="Long">
        delete from eq_status where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
