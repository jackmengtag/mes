<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.integration.mapper.IntReconcileTaskMapper">

    <resultMap type="IntReconcileTask" id="IntReconcileTaskResult">
        <id     property="id"    column="id"    />
        <result property="taskNo"    column="task_no"    />
        <result property="targetSystem"    column="target_system"    />
        <result property="bizDate"    column="biz_date"    />
        <result property="status"    column="status"    />
        <result property="diffCount"    column="diff_count"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectIntReconcileTaskVo">
        select id, task_no, target_system, biz_date, status, diff_count, start_time, end_time, create_by, create_time, update_by, update_time, remark from int_reconcile_task
    </sql>

    <select id="selectIntReconcileTaskList" parameterType="IntReconcileTask" resultMap="IntReconcileTaskResult">
        <include refid="selectIntReconcileTaskVo"/>
        <where>
            <if test="taskNo != null and taskNo != ''">
                AND task_no like concat('%', #{taskNo}, '%')
            </if>
            <if test="targetSystem != null and targetSystem != ''">
                AND target_system = #{targetSystem}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectIntReconcileTaskById" parameterType="Long" resultMap="IntReconcileTaskResult">
        <include refid="selectIntReconcileTaskVo"/>
        where id = #{id}
    </select>

    <insert id="insertIntReconcileTask" parameterType="IntReconcileTask" useGeneratedKeys="true" keyProperty="id">
        insert into int_reconcile_task(
            task_no,
            target_system,
            biz_date,
            status,
            diff_count,
            start_time,
            end_time,
            create_by, create_time
        )values(
            #{taskNo},
            #{targetSystem},
            #{bizDate},
            #{status},
            #{diffCount},
            #{startTime},
            #{endTime},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateIntReconcileTask" parameterType="IntReconcileTask">
        update int_reconcile_task
        <set>
            <if test="taskNo != null">task_no = #{taskNo},</if>
            <if test="targetSystem != null">target_system = #{targetSystem},</if>
            <if test="bizDate != null">biz_date = #{bizDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="diffCount != null">diff_count = #{diffCount},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteIntReconcileTaskById" parameterType="Long">
        delete from int_reconcile_task where id = #{id}
    </delete>

    <delete id="deleteIntReconcileTaskByIds" parameterType="Long">
        delete from int_reconcile_task where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
