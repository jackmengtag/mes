<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.tr.mapper.TrTraceIndexMapper">

    <resultMap type="TrTraceIndex" id="TrTraceIndexResult">
        <id     property="id"    column="id"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="materialBatchNo"    column="material_batch_no"    />
        <result property="equipmentCode"    column="equipment_code"    />
        <result property="operatorNo"    column="operator_no"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="routeVersion"    column="route_version"    />
        <result property="refType"    column="ref_type"    />
        <result property="refId"    column="ref_id"    />
        <result property="bizTime"    column="biz_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectTrTraceIndexVo">
        select id, serial_no, production_order_id, order_no, material_batch_no, equipment_code, operator_no, operation_code, route_version, ref_type, ref_id, biz_time, create_by, create_time, update_by, update_time, remark from tr_trace_index
    </sql>

    <select id="selectTrTraceIndexList" parameterType="TrTraceIndex" resultMap="TrTraceIndexResult">
        <include refid="selectTrTraceIndexVo"/>
        <where>
            <if test="serialNo != null and serialNo != ''">
                AND serial_no like concat('%', #{serialNo}, '%')
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="materialBatchNo != null and materialBatchNo != ''">
                AND material_batch_no like concat('%', #{materialBatchNo}, '%')
            </if>
            <if test="equipmentCode != null and equipmentCode != ''">
                AND equipment_code like concat('%', #{equipmentCode}, '%')
            </if>
            <if test="operationCode != null and operationCode != ''">
                AND operation_code = #{operationCode}
            </if>
            <if test="refType != null and refType != ''">
                AND ref_type = #{refType}
            </if>
        </where>
    </select>

    <select id="selectTrTraceIndexById" parameterType="Long" resultMap="TrTraceIndexResult">
        <include refid="selectTrTraceIndexVo"/>
        where id = #{id}
    </select>

    <insert id="insertTrTraceIndex" parameterType="TrTraceIndex" useGeneratedKeys="true" keyProperty="id">
        insert into tr_trace_index(
            serial_no,
            production_order_id,
            order_no,
            material_batch_no,
            equipment_code,
            operator_no,
            operation_code,
            route_version,
            ref_type,
            ref_id,
            biz_time,
            create_by, create_time
        )values(
            #{serialNo},
            #{productionOrderId},
            #{orderNo},
            #{materialBatchNo},
            #{equipmentCode},
            #{operatorNo},
            #{operationCode},
            #{routeVersion},
            #{refType},
            #{refId},
            #{bizTime},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateTrTraceIndex" parameterType="TrTraceIndex">
        update tr_trace_index
        <set>
            <if test="serialNo != null">serial_no = #{serialNo},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="materialBatchNo != null">material_batch_no = #{materialBatchNo},</if>
            <if test="equipmentCode != null">equipment_code = #{equipmentCode},</if>
            <if test="operatorNo != null">operator_no = #{operatorNo},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="routeVersion != null">route_version = #{routeVersion},</if>
            <if test="refType != null">ref_type = #{refType},</if>
            <if test="refId != null">ref_id = #{refId},</if>
            <if test="bizTime != null">biz_time = #{bizTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteTrTraceIndexById" parameterType="Long">
        delete from tr_trace_index where id = #{id}
    </delete>

    <delete id="deleteTrTraceIndexByIds" parameterType="Long">
        delete from tr_trace_index where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
