<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.ex.mapper.ExWipMapper">

    <resultMap type="ExWip" id="ExWipResult">
        <id     property="id"    column="id"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="wipQty"    column="wip_qty"    />
        <result property="stayMinutes"    column="stay_minutes"    />
        <result property="statTime"    column="stat_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectExWipVo">
        select id, production_order_id, order_no, operation_code, wip_qty, stay_minutes, stat_time, create_by, create_time, update_by, update_time, remark from ex_wip
    </sql>

    <select id="selectExWipList" parameterType="ExWip" resultMap="ExWipResult">
        <include refid="selectExWipVo"/>
        <where>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="operationCode != null and operationCode != ''">
                AND operation_code = #{operationCode}
            </if>
        </where>
    </select>

    <select id="selectExWipById" parameterType="Long" resultMap="ExWipResult">
        <include refid="selectExWipVo"/>
        where id = #{id}
    </select>

    <insert id="insertExWip" parameterType="ExWip" useGeneratedKeys="true" keyProperty="id">
        insert into ex_wip(
            production_order_id,
            order_no,
            operation_code,
            wip_qty,
            stay_minutes,
            stat_time,
            create_by, create_time
        )values(
            #{productionOrderId},
            #{orderNo},
            #{operationCode},
            #{wipQty},
            #{stayMinutes},
            #{statTime},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateExWip" parameterType="ExWip">
        update ex_wip
        <set>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="wipQty != null">wip_qty = #{wipQty},</if>
            <if test="stayMinutes != null">stay_minutes = #{stayMinutes},</if>
            <if test="statTime != null">stat_time = #{statTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteExWipById" parameterType="Long">
        delete from ex_wip where id = #{id}
    </delete>

    <delete id="deleteExWipByIds" parameterType="Long">
        delete from ex_wip where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
