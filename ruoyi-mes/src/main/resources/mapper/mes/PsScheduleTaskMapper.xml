<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.ps.mapper.PsScheduleTaskMapper">

    <resultMap type="PsScheduleTask" id="PsScheduleTaskResult">
        <id     property="id"    column="id"    />
        <result property="planId"    column="plan_id"    />
        <result property="workOrderId"    column="work_order_id"    />
        <result property="lineId"    column="line_id"    />
        <result property="sequenceNo"    column="sequence_no"    />
        <result property="plannedStartTime"    column="planned_start_time"    />
        <result property="plannedEndTime"    column="planned_end_time"    />
        <result property="scheduleType"    column="schedule_type"    />
        <result property="conflictFlag"    column="conflict_flag"    />
        <result property="conflictReason"    column="conflict_reason"    />
        <result property="adjustReason"    column="adjust_reason"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectPsScheduleTaskVo">
        select id, plan_id, work_order_id, line_id, sequence_no, planned_start_time, planned_end_time, schedule_type, conflict_flag, conflict_reason, adjust_reason, status, create_by, create_time, update_by, update_time, remark from ps_schedule_task
    </sql>

    <select id="selectPsScheduleTaskList" parameterType="PsScheduleTask" resultMap="PsScheduleTaskResult">
        <include refid="selectPsScheduleTaskVo"/>
        <where>
            <if test="planId != null and planId != ''">
                AND plan_id = #{planId}
            </if>
            <if test="workOrderId != null and workOrderId != ''">
                AND work_order_id = #{workOrderId}
            </if>
            <if test="lineId != null and lineId != ''">
                AND line_id = #{lineId}
            </if>
            <if test="scheduleType != null and scheduleType != ''">
                AND schedule_type = #{scheduleType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectPsScheduleTaskById" parameterType="Long" resultMap="PsScheduleTaskResult">
        <include refid="selectPsScheduleTaskVo"/>
        where id = #{id}
    </select>

    <insert id="insertPsScheduleTask" parameterType="PsScheduleTask" useGeneratedKeys="true" keyProperty="id">
        insert into ps_schedule_task(
            plan_id,
            work_order_id,
            line_id,
            sequence_no,
            planned_start_time,
            planned_end_time,
            schedule_type,
            conflict_flag,
            conflict_reason,
            adjust_reason,
            status,
            create_by, create_time
        )values(
            #{planId},
            #{workOrderId},
            #{lineId},
            #{sequenceNo},
            #{plannedStartTime},
            #{plannedEndTime},
            #{scheduleType},
            #{conflictFlag},
            #{conflictReason},
            #{adjustReason},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updatePsScheduleTask" parameterType="PsScheduleTask">
        update ps_schedule_task
        <set>
            <if test="planId != null">plan_id = #{planId},</if>
            <if test="workOrderId != null">work_order_id = #{workOrderId},</if>
            <if test="lineId != null">line_id = #{lineId},</if>
            <if test="sequenceNo != null">sequence_no = #{sequenceNo},</if>
            <if test="plannedStartTime != null">planned_start_time = #{plannedStartTime},</if>
            <if test="plannedEndTime != null">planned_end_time = #{plannedEndTime},</if>
            <if test="scheduleType != null">schedule_type = #{scheduleType},</if>
            <if test="conflictFlag != null">conflict_flag = #{conflictFlag},</if>
            <if test="conflictReason != null">conflict_reason = #{conflictReason},</if>
            <if test="adjustReason != null">adjust_reason = #{adjustReason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deletePsScheduleTaskById" parameterType="Long">
        delete from ps_schedule_task where id = #{id}
    </delete>

    <delete id="deletePsScheduleTaskByIds" parameterType="Long">
        delete from ps_schedule_task where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
