<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.eq.mapper.EqSpotCheckMapper">

    <resultMap type="EqSpotCheck" id="EqSpotCheckResult">
        <id     property="id"    column="id"    />
        <result property="equipmentId"    column="equipment_id"    />
        <result property="equipmentCode"    column="equipment_code"    />
        <result property="planTime"    column="plan_time"    />
        <result property="checkResult"    column="check_result"    />
        <result property="checkerNo"    column="checker_no"    />
        <result property="problemDesc"    column="problem_desc"    />
        <result property="repairRequired"    column="repair_required"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectEqSpotCheckVo">
        select id, equipment_id, equipment_code, plan_time, check_result, checker_no, problem_desc, repair_required, create_by, create_time, update_by, update_time, remark from eq_spot_check
    </sql>

    <select id="selectEqSpotCheckList" parameterType="EqSpotCheck" resultMap="EqSpotCheckResult">
        <include refid="selectEqSpotCheckVo"/>
        <where>
            <if test="equipmentId != null and equipmentId != ''">
                AND equipment_id = #{equipmentId}
            </if>
            <if test="equipmentCode != null and equipmentCode != ''">
                AND equipment_code like concat('%', #{equipmentCode}, '%')
            </if>
            <if test="checkResult != null and checkResult != ''">
                AND check_result = #{checkResult}
            </if>
        </where>
    </select>

    <select id="selectEqSpotCheckById" parameterType="Long" resultMap="EqSpotCheckResult">
        <include refid="selectEqSpotCheckVo"/>
        where id = #{id}
    </select>

    <insert id="insertEqSpotCheck" parameterType="EqSpotCheck" useGeneratedKeys="true" keyProperty="id">
        insert into eq_spot_check(
            equipment_id,
            equipment_code,
            plan_time,
            check_result,
            checker_no,
            problem_desc,
            repair_required,
            create_by, create_time
        )values(
            #{equipmentId},
            #{equipmentCode},
            #{planTime},
            #{checkResult},
            #{checkerNo},
            #{problemDesc},
            #{repairRequired},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateEqSpotCheck" parameterType="EqSpotCheck">
        update eq_spot_check
        <set>
            <if test="equipmentId != null">equipment_id = #{equipmentId},</if>
            <if test="equipmentCode != null">equipment_code = #{equipmentCode},</if>
            <if test="planTime != null">plan_time = #{planTime},</if>
            <if test="checkResult != null">check_result = #{checkResult},</if>
            <if test="checkerNo != null">checker_no = #{checkerNo},</if>
            <if test="problemDesc != null">problem_desc = #{problemDesc},</if>
            <if test="repairRequired != null">repair_required = #{repairRequired},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteEqSpotCheckById" parameterType="Long">
        delete from eq_spot_check where id = #{id}
    </delete>

    <delete id="deleteEqSpotCheckByIds" parameterType="Long">
        delete from eq_spot_check where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
