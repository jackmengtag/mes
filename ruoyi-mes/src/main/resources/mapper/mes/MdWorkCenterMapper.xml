<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdWorkCenterMapper">

    <resultMap type="MdWorkCenter" id="MdWorkCenterResult">
        <id     property="id"    column="id"    />
        <result property="workCenterCode"    column="work_center_code"    />
        <result property="workCenterName"    column="work_center_name"    />
        <result property="lineId"    column="line_id"    />
        <result property="capacity"    column="capacity"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdWorkCenterVo">
        select id, work_center_code, work_center_name, line_id, capacity, status, create_by, create_time, update_by, update_time, remark from md_work_center
    </sql>

    <select id="selectMdWorkCenterList" parameterType="MdWorkCenter" resultMap="MdWorkCenterResult">
        <include refid="selectMdWorkCenterVo"/>
        <where>
            <if test="workCenterCode != null and workCenterCode != ''">
                AND work_center_code like concat('%', #{workCenterCode}, '%')
            </if>
            <if test="workCenterName != null and workCenterName != ''">
                AND work_center_name like concat('%', #{workCenterName}, '%')
            </if>
            <if test="lineId != null and lineId != ''">
                AND line_id = #{lineId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMdWorkCenterById" parameterType="Long" resultMap="MdWorkCenterResult">
        <include refid="selectMdWorkCenterVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdWorkCenter" parameterType="MdWorkCenter" useGeneratedKeys="true" keyProperty="id">
        insert into md_work_center(
            work_center_code,
            work_center_name,
            line_id,
            capacity,
            status,
            create_by, create_time
        )values(
            #{workCenterCode},
            #{workCenterName},
            #{lineId},
            #{capacity},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdWorkCenter" parameterType="MdWorkCenter">
        update md_work_center
        <set>
            <if test="workCenterCode != null">work_center_code = #{workCenterCode},</if>
            <if test="workCenterName != null">work_center_name = #{workCenterName},</if>
            <if test="lineId != null">line_id = #{lineId},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdWorkCenterById" parameterType="Long">
        delete from md_work_center where id = #{id}
    </delete>

    <delete id="deleteMdWorkCenterByIds" parameterType="Long">
        delete from md_work_center where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
