<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdShiftMapper">

    <resultMap type="MdShift" id="MdShiftResult">
        <id     property="id"    column="id"    />
        <result property="shiftCode"    column="shift_code"    />
        <result property="shiftName"    column="shift_name"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdShiftVo">
        select id, shift_code, shift_name, start_time, end_time, status, create_by, create_time, update_by, update_time, remark from md_shift
    </sql>

    <select id="selectMdShiftList" parameterType="MdShift" resultMap="MdShiftResult">
        <include refid="selectMdShiftVo"/>
        <where>
            <if test="shiftCode != null and shiftCode != ''">
                AND shift_code like concat('%', #{shiftCode}, '%')
            </if>
            <if test="shiftName != null and shiftName != ''">
                AND shift_name like concat('%', #{shiftName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMdShiftById" parameterType="Long" resultMap="MdShiftResult">
        <include refid="selectMdShiftVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdShift" parameterType="MdShift" useGeneratedKeys="true" keyProperty="id">
        insert into md_shift(
            shift_code,
            shift_name,
            start_time,
            end_time,
            status,
            create_by, create_time
        )values(
            #{shiftCode},
            #{shiftName},
            #{startTime},
            #{endTime},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdShift" parameterType="MdShift">
        update md_shift
        <set>
            <if test="shiftCode != null">shift_code = #{shiftCode},</if>
            <if test="shiftName != null">shift_name = #{shiftName},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdShiftById" parameterType="Long">
        delete from md_shift where id = #{id}
    </delete>

    <delete id="deleteMdShiftByIds" parameterType="Long">
        delete from md_shift where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
