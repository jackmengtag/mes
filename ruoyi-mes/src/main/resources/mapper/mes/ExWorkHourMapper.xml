<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.ex.mapper.ExWorkHourMapper">

    <resultMap type="ExWorkHour" id="ExWorkHourResult">
        <id     property="id"    column="id"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="operationTaskId"    column="operation_task_id"    />
        <result property="workType"    column="work_type"    />
        <result property="minutes"    column="minutes"    />
        <result property="operatorNo"    column="operator_no"    />
        <result property="recordTime"    column="record_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectExWorkHourVo">
        select id, production_order_id, operation_task_id, work_type, minutes, operator_no, record_time, create_by, create_time, update_by, update_time, remark from ex_work_hour
    </sql>

    <select id="selectExWorkHourList" parameterType="ExWorkHour" resultMap="ExWorkHourResult">
        <include refid="selectExWorkHourVo"/>
        <where>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="operationTaskId != null and operationTaskId != ''">
                AND operation_task_id = #{operationTaskId}
            </if>
            <if test="workType != null and workType != ''">
                AND work_type = #{workType}
            </if>
            <if test="operatorNo != null and operatorNo != ''">
                AND operator_no like concat('%', #{operatorNo}, '%')
            </if>
        </where>
    </select>

    <select id="selectExWorkHourById" parameterType="Long" resultMap="ExWorkHourResult">
        <include refid="selectExWorkHourVo"/>
        where id = #{id}
    </select>

    <insert id="insertExWorkHour" parameterType="ExWorkHour" useGeneratedKeys="true" keyProperty="id">
        insert into ex_work_hour(
            production_order_id,
            operation_task_id,
            work_type,
            minutes,
            operator_no,
            record_time,
            create_by, create_time
        )values(
            #{productionOrderId},
            #{operationTaskId},
            #{workType},
            #{minutes},
            #{operatorNo},
            #{recordTime},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateExWorkHour" parameterType="ExWorkHour">
        update ex_work_hour
        <set>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="operationTaskId != null">operation_task_id = #{operationTaskId},</if>
            <if test="workType != null">work_type = #{workType},</if>
            <if test="minutes != null">minutes = #{minutes},</if>
            <if test="operatorNo != null">operator_no = #{operatorNo},</if>
            <if test="recordTime != null">record_time = #{recordTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteExWorkHourById" parameterType="Long">
        delete from ex_work_hour where id = #{id}
    </delete>

    <delete id="deleteExWorkHourByIds" parameterType="Long">
        delete from ex_work_hour where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
