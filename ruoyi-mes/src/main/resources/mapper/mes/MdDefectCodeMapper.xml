<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdDefectCodeMapper">

    <resultMap type="MdDefectCode" id="MdDefectCodeResult">
        <id     property="id"    column="id"    />
        <result property="defectCode"    column="defect_code"    />
        <result property="defectName"    column="defect_name"    />
        <result property="defectCategory"    column="defect_category"    />
        <result property="respDept"    column="resp_dept"    />
        <result property="defaultDisposition"    column="default_disposition"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdDefectCodeVo">
        select id, defect_code, defect_name, defect_category, resp_dept, default_disposition, status, create_by, create_time, update_by, update_time, remark from md_defect_code
    </sql>

    <select id="selectMdDefectCodeList" parameterType="MdDefectCode" resultMap="MdDefectCodeResult">
        <include refid="selectMdDefectCodeVo"/>
        <where>
            <if test="defectCode != null and defectCode != ''">
                AND defect_code like concat('%', #{defectCode}, '%')
            </if>
            <if test="defectName != null and defectName != ''">
                AND defect_name like concat('%', #{defectName}, '%')
            </if>
            <if test="defectCategory != null and defectCategory != ''">
                AND defect_category = #{defectCategory}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMdDefectCodeById" parameterType="Long" resultMap="MdDefectCodeResult">
        <include refid="selectMdDefectCodeVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdDefectCode" parameterType="MdDefectCode" useGeneratedKeys="true" keyProperty="id">
        insert into md_defect_code(
            defect_code,
            defect_name,
            defect_category,
            resp_dept,
            default_disposition,
            status,
            create_by, create_time
        )values(
            #{defectCode},
            #{defectName},
            #{defectCategory},
            #{respDept},
            #{defaultDisposition},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdDefectCode" parameterType="MdDefectCode">
        update md_defect_code
        <set>
            <if test="defectCode != null">defect_code = #{defectCode},</if>
            <if test="defectName != null">defect_name = #{defectName},</if>
            <if test="defectCategory != null">defect_category = #{defectCategory},</if>
            <if test="respDept != null">resp_dept = #{respDept},</if>
            <if test="defaultDisposition != null">default_disposition = #{defaultDisposition},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdDefectCodeById" parameterType="Long">
        delete from md_defect_code where id = #{id}
    </delete>

    <delete id="deleteMdDefectCodeByIds" parameterType="Long">
        delete from md_defect_code where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
