<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdBomLineMapper">

    <resultMap type="MdBomLine" id="MdBomLineResult">
        <id     property="id"    column="id"    />
        <result property="bomId"    column="bom_id"    />
        <result property="materialId"    column="material_id"    />
        <result property="materialCode"    column="material_code"    />
        <result property="materialName"    column="material_name"    />
        <result property="quantity"    column="quantity"    />
        <result property="lossRate"    column="loss_rate"    />
        <result property="feedingOperationCode"    column="feeding_operation_code"    />
        <result property="keyFlag"    column="key_flag"    />
        <result property="batchBindFlag"    column="batch_bind_flag"    />
        <result property="substituteFlag"    column="substitute_flag"    />
        <result property="substituteMaterialCode"    column="substitute_material_code"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdBomLineVo">
        select id, bom_id, material_id, material_code, material_name, quantity, loss_rate, feeding_operation_code, key_flag, batch_bind_flag, substitute_flag, substitute_material_code, create_by, create_time, update_by, update_time, remark from md_bom_line
    </sql>

    <select id="selectMdBomLineList" parameterType="MdBomLine" resultMap="MdBomLineResult">
        <include refid="selectMdBomLineVo"/>
        <where>
            <if test="bomId != null and bomId != ''">
                AND bom_id = #{bomId}
            </if>
            <if test="materialId != null and materialId != ''">
                AND material_id = #{materialId}
            </if>
            <if test="materialCode != null and materialCode != ''">
                AND material_code like concat('%', #{materialCode}, '%')
            </if>
            <if test="materialName != null and materialName != ''">
                AND material_name like concat('%', #{materialName}, '%')
            </if>
        </where>
    </select>

    <select id="selectMdBomLineById" parameterType="Long" resultMap="MdBomLineResult">
        <include refid="selectMdBomLineVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdBomLine" parameterType="MdBomLine" useGeneratedKeys="true" keyProperty="id">
        insert into md_bom_line(
            bom_id,
            material_id,
            material_code,
            material_name,
            quantity,
            loss_rate,
            feeding_operation_code,
            key_flag,
            batch_bind_flag,
            substitute_flag,
            substitute_material_code,
            create_by, create_time
        )values(
            #{bomId},
            #{materialId},
            #{materialCode},
            #{materialName},
            #{quantity},
            #{lossRate},
            #{feedingOperationCode},
            #{keyFlag},
            #{batchBindFlag},
            #{substituteFlag},
            #{substituteMaterialCode},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdBomLine" parameterType="MdBomLine">
        update md_bom_line
        <set>
            <if test="bomId != null">bom_id = #{bomId},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="materialCode != null">material_code = #{materialCode},</if>
            <if test="materialName != null">material_name = #{materialName},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="lossRate != null">loss_rate = #{lossRate},</if>
            <if test="feedingOperationCode != null">feeding_operation_code = #{feedingOperationCode},</if>
            <if test="keyFlag != null">key_flag = #{keyFlag},</if>
            <if test="batchBindFlag != null">batch_bind_flag = #{batchBindFlag},</if>
            <if test="substituteFlag != null">substitute_flag = #{substituteFlag},</if>
            <if test="substituteMaterialCode != null">substitute_material_code = #{substituteMaterialCode},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdBomLineById" parameterType="Long">
        delete from md_bom_line where id = #{id}
    </delete>

    <delete id="deleteMdBomLineByIds" parameterType="Long">
        delete from md_bom_line where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
