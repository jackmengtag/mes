<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdInspectionPlanMapper">

    <resultMap type="MdInspectionPlan" id="MdInspectionPlanResult">
        <id     property="id"    column="id"    />
        <result property="planCode"    column="plan_code"    />
        <result property="planName"    column="plan_name"    />
        <result property="inspectionType"    column="inspection_type"    />
        <result property="productId"    column="product_id"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="versionNo"    column="version_no"    />
        <result property="docStatus"    column="doc_status"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdInspectionPlanVo">
        select id, plan_code, plan_name, inspection_type, product_id, operation_code, version_no, doc_status, status, create_by, create_time, update_by, update_time, remark from md_inspection_plan
    </sql>

    <select id="selectMdInspectionPlanList" parameterType="MdInspectionPlan" resultMap="MdInspectionPlanResult">
        <include refid="selectMdInspectionPlanVo"/>
        <where>
            <if test="planCode != null and planCode != ''">
                AND plan_code like concat('%', #{planCode}, '%')
            </if>
            <if test="planName != null and planName != ''">
                AND plan_name like concat('%', #{planName}, '%')
            </if>
            <if test="inspectionType != null and inspectionType != ''">
                AND inspection_type = #{inspectionType}
            </if>
            <if test="productId != null and productId != ''">
                AND product_id = #{productId}
            </if>
            <if test="versionNo != null and versionNo != ''">
                AND version_no like concat('%', #{versionNo}, '%')
            </if>
            <if test="docStatus != null and docStatus != ''">
                AND doc_status = #{docStatus}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMdInspectionPlanById" parameterType="Long" resultMap="MdInspectionPlanResult">
        <include refid="selectMdInspectionPlanVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdInspectionPlan" parameterType="MdInspectionPlan" useGeneratedKeys="true" keyProperty="id">
        insert into md_inspection_plan(
            plan_code,
            plan_name,
            inspection_type,
            product_id,
            operation_code,
            version_no,
            doc_status,
            status,
            create_by, create_time
        )values(
            #{planCode},
            #{planName},
            #{inspectionType},
            #{productId},
            #{operationCode},
            #{versionNo},
            #{docStatus},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdInspectionPlan" parameterType="MdInspectionPlan">
        update md_inspection_plan
        <set>
            <if test="planCode != null">plan_code = #{planCode},</if>
            <if test="planName != null">plan_name = #{planName},</if>
            <if test="inspectionType != null">inspection_type = #{inspectionType},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="versionNo != null">version_no = #{versionNo},</if>
            <if test="docStatus != null">doc_status = #{docStatus},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdInspectionPlanById" parameterType="Long">
        delete from md_inspection_plan where id = #{id}
    </delete>

    <delete id="deleteMdInspectionPlanByIds" parameterType="Long">
        delete from md_inspection_plan where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
