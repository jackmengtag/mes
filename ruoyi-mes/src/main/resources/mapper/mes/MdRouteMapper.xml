<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdRouteMapper">

    <resultMap type="MdRoute" id="MdRouteResult">
        <id     property="id"    column="id"    />
        <result property="routeCode"    column="route_code"    />
        <result property="routeName"    column="route_name"    />
        <result property="productId"    column="product_id"    />
        <result property="productCode"    column="product_code"    />
        <result property="versionNo"    column="version_no"    />
        <result property="docStatus"    column="doc_status"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdRouteVo">
        select id, route_code, route_name, product_id, product_code, version_no, doc_status, status, create_by, create_time, update_by, update_time, remark from md_route
    </sql>

    <select id="selectMdRouteList" parameterType="MdRoute" resultMap="MdRouteResult">
        <include refid="selectMdRouteVo"/>
        <where>
            <if test="routeCode != null and routeCode != ''">
                AND route_code like concat('%', #{routeCode}, '%')
            </if>
            <if test="routeName != null and routeName != ''">
                AND route_name like concat('%', #{routeName}, '%')
            </if>
            <if test="productId != null and productId != ''">
                AND product_id = #{productId}
            </if>
            <if test="productCode != null and productCode != ''">
                AND product_code like concat('%', #{productCode}, '%')
            </if>
            <if test="versionNo != null and versionNo != ''">
                AND version_no like concat('%', #{versionNo}, '%')
            </if>
            <if test="docStatus != null and docStatus != ''">
                AND doc_status = #{docStatus}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMdRouteById" parameterType="Long" resultMap="MdRouteResult">
        <include refid="selectMdRouteVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdRoute" parameterType="MdRoute" useGeneratedKeys="true" keyProperty="id">
        insert into md_route(
            route_code,
            route_name,
            product_id,
            product_code,
            version_no,
            doc_status,
            status,
            create_by, create_time
        )values(
            #{routeCode},
            #{routeName},
            #{productId},
            #{productCode},
            #{versionNo},
            #{docStatus},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdRoute" parameterType="MdRoute">
        update md_route
        <set>
            <if test="routeCode != null">route_code = #{routeCode},</if>
            <if test="routeName != null">route_name = #{routeName},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="versionNo != null">version_no = #{versionNo},</if>
            <if test="docStatus != null">doc_status = #{docStatus},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdRouteById" parameterType="Long">
        delete from md_route where id = #{id}
    </delete>

    <delete id="deleteMdRouteByIds" parameterType="Long">
        delete from md_route where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
