<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdInspectionPlanItemMapper">

    <resultMap type="MdInspectionPlanItem" id="MdInspectionPlanItemResult">
        <id     property="id"    column="id"    />
        <result property="planId"    column="plan_id"    />
        <result property="itemId"    column="item_id"    />
        <result property="itemCode"    column="item_code"    />
        <result property="itemName"    column="item_name"    />
        <result property="lowerLimit"    column="lower_limit"    />
        <result property="upperLimit"    column="upper_limit"    />
        <result property="unit"    column="unit"    />
        <result property="samplingRule"    column="sampling_rule"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdInspectionPlanItemVo">
        select id, plan_id, item_id, item_code, item_name, lower_limit, upper_limit, unit, sampling_rule, create_by, create_time, update_by, update_time, remark from md_inspection_plan_item
    </sql>

    <select id="selectMdInspectionPlanItemList" parameterType="MdInspectionPlanItem" resultMap="MdInspectionPlanItemResult">
        <include refid="selectMdInspectionPlanItemVo"/>
        <where>
            <if test="planId != null and planId != ''">
                AND plan_id = #{planId}
            </if>
            <if test="itemId != null and itemId != ''">
                AND item_id = #{itemId}
            </if>
            <if test="itemCode != null and itemCode != ''">
                AND item_code like concat('%', #{itemCode}, '%')
            </if>
            <if test="itemName != null and itemName != ''">
                AND item_name like concat('%', #{itemName}, '%')
            </if>
        </where>
    </select>

    <select id="selectMdInspectionPlanItemById" parameterType="Long" resultMap="MdInspectionPlanItemResult">
        <include refid="selectMdInspectionPlanItemVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdInspectionPlanItem" parameterType="MdInspectionPlanItem" useGeneratedKeys="true" keyProperty="id">
        insert into md_inspection_plan_item(
            plan_id,
            item_id,
            item_code,
            item_name,
            lower_limit,
            upper_limit,
            unit,
            sampling_rule,
            create_by, create_time
        )values(
            #{planId},
            #{itemId},
            #{itemCode},
            #{itemName},
            #{lowerLimit},
            #{upperLimit},
            #{unit},
            #{samplingRule},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdInspectionPlanItem" parameterType="MdInspectionPlanItem">
        update md_inspection_plan_item
        <set>
            <if test="planId != null">plan_id = #{planId},</if>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="itemCode != null">item_code = #{itemCode},</if>
            <if test="itemName != null">item_name = #{itemName},</if>
            <if test="lowerLimit != null">lower_limit = #{lowerLimit},</if>
            <if test="upperLimit != null">upper_limit = #{upperLimit},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="samplingRule != null">sampling_rule = #{samplingRule},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdInspectionPlanItemById" parameterType="Long">
        delete from md_inspection_plan_item where id = #{id}
    </delete>

    <delete id="deleteMdInspectionPlanItemByIds" parameterType="Long">
        delete from md_inspection_plan_item where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
