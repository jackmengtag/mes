<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdEmployeeMapper">

    <resultMap type="MdEmployee" id="MdEmployeeResult">
        <id     property="id"    column="id"    />
        <result property="empNo"    column="emp_no"    />
        <result property="empName"    column="emp_name"    />
        <result property="postName"    column="post_name"    />
        <result property="skills"    column="skills"    />
        <result property="teamId"    column="team_id"    />
        <result property="shiftId"    column="shift_id"    />
        <result property="userId"    column="user_id"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdEmployeeVo">
        select id, emp_no, emp_name, post_name, skills, team_id, shift_id, user_id, status, create_by, create_time, update_by, update_time, remark from md_employee
    </sql>

    <select id="selectMdEmployeeList" parameterType="MdEmployee" resultMap="MdEmployeeResult">
        <include refid="selectMdEmployeeVo"/>
        <where>
            <if test="empNo != null and empNo != ''">
                AND emp_no like concat('%', #{empNo}, '%')
            </if>
            <if test="empName != null and empName != ''">
                AND emp_name like concat('%', #{empName}, '%')
            </if>
            <if test="teamId != null and teamId != ''">
                AND team_id = #{teamId}
            </if>
            <if test="shiftId != null and shiftId != ''">
                AND shift_id = #{shiftId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMdEmployeeById" parameterType="Long" resultMap="MdEmployeeResult">
        <include refid="selectMdEmployeeVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdEmployee" parameterType="MdEmployee" useGeneratedKeys="true" keyProperty="id">
        insert into md_employee(
            emp_no,
            emp_name,
            post_name,
            skills,
            team_id,
            shift_id,
            user_id,
            status,
            create_by, create_time
        )values(
            #{empNo},
            #{empName},
            #{postName},
            #{skills},
            #{teamId},
            #{shiftId},
            #{userId},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdEmployee" parameterType="MdEmployee">
        update md_employee
        <set>
            <if test="empNo != null">emp_no = #{empNo},</if>
            <if test="empName != null">emp_name = #{empName},</if>
            <if test="postName != null">post_name = #{postName},</if>
            <if test="skills != null">skills = #{skills},</if>
            <if test="teamId != null">team_id = #{teamId},</if>
            <if test="shiftId != null">shift_id = #{shiftId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdEmployeeById" parameterType="Long">
        delete from md_employee where id = #{id}
    </delete>

    <delete id="deleteMdEmployeeByIds" parameterType="Long">
        delete from md_employee where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
