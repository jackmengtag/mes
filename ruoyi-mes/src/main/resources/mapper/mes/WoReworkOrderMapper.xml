<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.wo.mapper.WoReworkOrderMapper">

    <resultMap type="WoReworkOrder" id="WoReworkOrderResult">
        <id     property="id"    column="id"    />
        <result property="reworkNo"    column="rework_no"    />
        <result property="originOrderId"    column="origin_order_id"    />
        <result property="originOrderNo"    column="origin_order_no"    />
        <result property="nonconformityId"    column="nonconformity_id"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="reworkQty"    column="rework_qty"    />
        <result property="reason"    column="reason"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWoReworkOrderVo">
        select id, rework_no, origin_order_id, origin_order_no, nonconformity_id, serial_no, operation_code, rework_qty, reason, status, create_by, create_time, update_by, update_time, remark from wo_rework_order
    </sql>

    <select id="selectWoReworkOrderList" parameterType="WoReworkOrder" resultMap="WoReworkOrderResult">
        <include refid="selectWoReworkOrderVo"/>
        <where>
            <if test="reworkNo != null and reworkNo != ''">
                AND rework_no like concat('%', #{reworkNo}, '%')
            </if>
            <if test="originOrderId != null and originOrderId != ''">
                AND origin_order_id = #{originOrderId}
            </if>
            <if test="originOrderNo != null and originOrderNo != ''">
                AND origin_order_no like concat('%', #{originOrderNo}, '%')
            </if>
            <if test="nonconformityId != null and nonconformityId != ''">
                AND nonconformity_id = #{nonconformityId}
            </if>
            <if test="serialNo != null and serialNo != ''">
                AND serial_no like concat('%', #{serialNo}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectWoReworkOrderById" parameterType="Long" resultMap="WoReworkOrderResult">
        <include refid="selectWoReworkOrderVo"/>
        where id = #{id}
    </select>

    <insert id="insertWoReworkOrder" parameterType="WoReworkOrder" useGeneratedKeys="true" keyProperty="id">
        insert into wo_rework_order(
            rework_no,
            origin_order_id,
            origin_order_no,
            nonconformity_id,
            serial_no,
            operation_code,
            rework_qty,
            reason,
            status,
            create_by, create_time
        )values(
            #{reworkNo},
            #{originOrderId},
            #{originOrderNo},
            #{nonconformityId},
            #{serialNo},
            #{operationCode},
            #{reworkQty},
            #{reason},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateWoReworkOrder" parameterType="WoReworkOrder">
        update wo_rework_order
        <set>
            <if test="reworkNo != null">rework_no = #{reworkNo},</if>
            <if test="originOrderId != null">origin_order_id = #{originOrderId},</if>
            <if test="originOrderNo != null">origin_order_no = #{originOrderNo},</if>
            <if test="nonconformityId != null">nonconformity_id = #{nonconformityId},</if>
            <if test="serialNo != null">serial_no = #{serialNo},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="reworkQty != null">rework_qty = #{reworkQty},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteWoReworkOrderById" parameterType="Long">
        delete from wo_rework_order where id = #{id}
    </delete>

    <delete id="deleteWoReworkOrderByIds" parameterType="Long">
        delete from wo_rework_order where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
