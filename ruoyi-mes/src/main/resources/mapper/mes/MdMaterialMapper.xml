<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdMaterialMapper">

    <resultMap type="MdMaterial" id="MdMaterialResult">
        <id     property="id"    column="id"    />
        <result property="materialCode"    column="material_code"    />
        <result property="materialName"    column="material_name"    />
        <result property="unit"    column="unit"    />
        <result property="materialType"    column="material_type"    />
        <result property="batchFlag"    column="batch_flag"    />
        <result property="serialFlag"    column="serial_flag"    />
        <result property="shelfLife"    column="shelf_life"    />
        <result property="keyFlag"    column="key_flag"    />
        <result property="inspectFlag"    column="inspect_flag"    />
        <result property="substituteFlag"    column="substitute_flag"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdMaterialVo">
        select id, material_code, material_name, unit, material_type, batch_flag, serial_flag, shelf_life, key_flag, inspect_flag, substitute_flag, status, create_by, create_time, update_by, update_time, remark from md_material
    </sql>

    <select id="selectMdMaterialList" parameterType="MdMaterial" resultMap="MdMaterialResult">
        <include refid="selectMdMaterialVo"/>
        <where>
            <if test="materialCode != null and materialCode != ''">
                AND material_code like concat('%', #{materialCode}, '%')
            </if>
            <if test="materialName != null and materialName != ''">
                AND material_name like concat('%', #{materialName}, '%')
            </if>
            <if test="materialType != null and materialType != ''">
                AND material_type = #{materialType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMdMaterialById" parameterType="Long" resultMap="MdMaterialResult">
        <include refid="selectMdMaterialVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdMaterial" parameterType="MdMaterial" useGeneratedKeys="true" keyProperty="id">
        insert into md_material(
            material_code,
            material_name,
            unit,
            material_type,
            batch_flag,
            serial_flag,
            shelf_life,
            key_flag,
            inspect_flag,
            substitute_flag,
            status,
            create_by, create_time
        )values(
            #{materialCode},
            #{materialName},
            #{unit},
            #{materialType},
            #{batchFlag},
            #{serialFlag},
            #{shelfLife},
            #{keyFlag},
            #{inspectFlag},
            #{substituteFlag},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdMaterial" parameterType="MdMaterial">
        update md_material
        <set>
            <if test="materialCode != null">material_code = #{materialCode},</if>
            <if test="materialName != null">material_name = #{materialName},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="materialType != null">material_type = #{materialType},</if>
            <if test="batchFlag != null">batch_flag = #{batchFlag},</if>
            <if test="serialFlag != null">serial_flag = #{serialFlag},</if>
            <if test="shelfLife != null">shelf_life = #{shelfLife},</if>
            <if test="keyFlag != null">key_flag = #{keyFlag},</if>
            <if test="inspectFlag != null">inspect_flag = #{inspectFlag},</if>
            <if test="substituteFlag != null">substitute_flag = #{substituteFlag},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdMaterialById" parameterType="Long">
        delete from md_material where id = #{id}
    </delete>

    <delete id="deleteMdMaterialByIds" parameterType="Long">
        delete from md_material where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
