<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdStationMapper">

    <resultMap type="MdStation" id="MdStationResult">
        <id     property="id"    column="id"    />
        <result property="stationCode"    column="station_code"    />
        <result property="stationName"    column="station_name"    />
        <result property="lineId"    column="line_id"    />
        <result property="workCenterId"    column="work_center_id"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdStationVo">
        select id, station_code, station_name, line_id, work_center_id, status, create_by, create_time, update_by, update_time, remark from md_station
    </sql>

    <select id="selectMdStationList" parameterType="MdStation" resultMap="MdStationResult">
        <include refid="selectMdStationVo"/>
        <where>
            <if test="stationCode != null and stationCode != ''">
                AND station_code like concat('%', #{stationCode}, '%')
            </if>
            <if test="stationName != null and stationName != ''">
                AND station_name like concat('%', #{stationName}, '%')
            </if>
            <if test="lineId != null and lineId != ''">
                AND line_id = #{lineId}
            </if>
            <if test="workCenterId != null and workCenterId != ''">
                AND work_center_id = #{workCenterId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMdStationById" parameterType="Long" resultMap="MdStationResult">
        <include refid="selectMdStationVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdStation" parameterType="MdStation" useGeneratedKeys="true" keyProperty="id">
        insert into md_station(
            station_code,
            station_name,
            line_id,
            work_center_id,
            status,
            create_by, create_time
        )values(
            #{stationCode},
            #{stationName},
            #{lineId},
            #{workCenterId},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdStation" parameterType="MdStation">
        update md_station
        <set>
            <if test="stationCode != null">station_code = #{stationCode},</if>
            <if test="stationName != null">station_name = #{stationName},</if>
            <if test="lineId != null">line_id = #{lineId},</if>
            <if test="workCenterId != null">work_center_id = #{workCenterId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdStationById" parameterType="Long">
        delete from md_station where id = #{id}
    </delete>

    <delete id="deleteMdStationByIds" parameterType="Long">
        delete from md_station where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
