<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.wo.mapper.WoProductionOrderMapper">

    <resultMap type="WoProductionOrder" id="WoProductionOrderResult">
        <id     property="id"    column="id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="sourceOrderNo"    column="source_order_no"    />
        <result property="erpWorkOrderNo"    column="erp_work_order_no"    />
        <result property="demandId"    column="demand_id"    />
        <result property="parentOrderId"    column="parent_order_id"    />
        <result property="splitReason"    column="split_reason"    />
        <result property="productId"    column="product_id"    />
        <result property="productCode"    column="product_code"    />
        <result property="productVersionId"    column="product_version_id"    />
        <result property="routeVersionId"    column="route_version_id"    />
        <result property="bomVersionId"    column="bom_version_id"    />
        <result property="inspectionPlanVersionId"    column="inspection_plan_version_id"    />
        <result property="lineId"    column="line_id"    />
        <result property="priority"    column="priority"    />
        <result property="plannedQty"    column="planned_qty"    />
        <result property="completedQty"    column="completed_qty"    />
        <result property="qualifiedQty"    column="qualified_qty"    />
        <result property="scrapQty"    column="scrap_qty"    />
        <result property="kitStatus"    column="kit_status"    />
        <result property="plannedStartTime"    column="planned_start_time"    />
        <result property="plannedEndTime"    column="planned_end_time"    />
        <result property="actualStartTime"    column="actual_start_time"    />
        <result property="actualEndTime"    column="actual_end_time"    />
        <result property="pauseReason"    column="pause_reason"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWoProductionOrderVo">
        select id, order_no, source_order_no, erp_work_order_no, demand_id, parent_order_id, split_reason, product_id, product_code, product_version_id, route_version_id, bom_version_id, inspection_plan_version_id, line_id, priority, planned_qty, completed_qty, qualified_qty, scrap_qty, kit_status, planned_start_time, planned_end_time, actual_start_time, actual_end_time, pause_reason, status, create_by, create_time, update_by, update_time, remark from wo_production_order
    </sql>

    <select id="selectWoProductionOrderList" parameterType="WoProductionOrder" resultMap="WoProductionOrderResult">
        <include refid="selectWoProductionOrderVo"/>
        <where>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="sourceOrderNo != null and sourceOrderNo != ''">
                AND source_order_no like concat('%', #{sourceOrderNo}, '%')
            </if>
            <if test="demandId != null and demandId != ''">
                AND demand_id = #{demandId}
            </if>
            <if test="parentOrderId != null and parentOrderId != ''">
                AND parent_order_id = #{parentOrderId}
            </if>
            <if test="productId != null and productId != ''">
                AND product_id = #{productId}
            </if>
            <if test="productCode != null and productCode != ''">
                AND product_code like concat('%', #{productCode}, '%')
            </if>
            <if test="lineId != null and lineId != ''">
                AND line_id = #{lineId}
            </if>
            <if test="priority != null and priority != ''">
                AND priority = #{priority}
            </if>
            <if test="kitStatus != null and kitStatus != ''">
                AND kit_status = #{kitStatus}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectWoProductionOrderById" parameterType="Long" resultMap="WoProductionOrderResult">
        <include refid="selectWoProductionOrderVo"/>
        where id = #{id}
    </select>

    <insert id="insertWoProductionOrder" parameterType="WoProductionOrder" useGeneratedKeys="true" keyProperty="id">
        insert into wo_production_order(
            order_no,
            source_order_no,
            erp_work_order_no,
            demand_id,
            parent_order_id,
            split_reason,
            product_id,
            product_code,
            product_version_id,
            route_version_id,
            bom_version_id,
            inspection_plan_version_id,
            line_id,
            priority,
            planned_qty,
            completed_qty,
            qualified_qty,
            scrap_qty,
            kit_status,
            planned_start_time,
            planned_end_time,
            actual_start_time,
            actual_end_time,
            pause_reason,
            status,
            create_by, create_time
        )values(
            #{orderNo},
            #{sourceOrderNo},
            #{erpWorkOrderNo},
            #{demandId},
            #{parentOrderId},
            #{splitReason},
            #{productId},
            #{productCode},
            #{productVersionId},
            #{routeVersionId},
            #{bomVersionId},
            #{inspectionPlanVersionId},
            #{lineId},
            #{priority},
            #{plannedQty},
            #{completedQty},
            #{qualifiedQty},
            #{scrapQty},
            #{kitStatus},
            #{plannedStartTime},
            #{plannedEndTime},
            #{actualStartTime},
            #{actualEndTime},
            #{pauseReason},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateWoProductionOrder" parameterType="WoProductionOrder">
        update wo_production_order
        <set>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="sourceOrderNo != null">source_order_no = #{sourceOrderNo},</if>
            <if test="erpWorkOrderNo != null">erp_work_order_no = #{erpWorkOrderNo},</if>
            <if test="demandId != null">demand_id = #{demandId},</if>
            <if test="parentOrderId != null">parent_order_id = #{parentOrderId},</if>
            <if test="splitReason != null">split_reason = #{splitReason},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="productVersionId != null">product_version_id = #{productVersionId},</if>
            <if test="routeVersionId != null">route_version_id = #{routeVersionId},</if>
            <if test="bomVersionId != null">bom_version_id = #{bomVersionId},</if>
            <if test="inspectionPlanVersionId != null">inspection_plan_version_id = #{inspectionPlanVersionId},</if>
            <if test="lineId != null">line_id = #{lineId},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="plannedQty != null">planned_qty = #{plannedQty},</if>
            <if test="completedQty != null">completed_qty = #{completedQty},</if>
            <if test="qualifiedQty != null">qualified_qty = #{qualifiedQty},</if>
            <if test="scrapQty != null">scrap_qty = #{scrapQty},</if>
            <if test="kitStatus != null">kit_status = #{kitStatus},</if>
            <if test="plannedStartTime != null">planned_start_time = #{plannedStartTime},</if>
            <if test="plannedEndTime != null">planned_end_time = #{plannedEndTime},</if>
            <if test="actualStartTime != null">actual_start_time = #{actualStartTime},</if>
            <if test="actualEndTime != null">actual_end_time = #{actualEndTime},</if>
            <if test="pauseReason != null">pause_reason = #{pauseReason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteWoProductionOrderById" parameterType="Long">
        delete from wo_production_order where id = #{id}
    </delete>

    <delete id="deleteWoProductionOrderByIds" parameterType="Long">
        delete from wo_production_order where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
