<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.integration.mapper.IntDomainEventMapper">

    <resultMap type="IntDomainEvent" id="IntDomainEventResult">
        <id     property="id"    column="id"    />
        <result property="eventId"    column="event_id"    />
        <result property="eventType"    column="event_type"    />
        <result property="aggregateType"    column="aggregate_type"    />
        <result property="aggregateId"    column="aggregate_id"    />
        <result property="payload"    column="payload"    />
        <result property="traceId"    column="trace_id"    />
        <result property="status"    column="status"    />
        <result property="retryCount"    column="retry_count"    />
        <result property="nextRetryTime"    column="next_retry_time"    />
        <result property="errorMsg"    column="error_msg"    />
        <result property="occurredAt"    column="occurred_at"    />
        <result property="processedAt"    column="processed_at"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectIntDomainEventVo">
        select id, event_id, event_type, aggregate_type, aggregate_id, payload, trace_id, status, retry_count, next_retry_time, error_msg, occurred_at, processed_at, create_by, create_time, update_by, update_time, remark from int_domain_event
    </sql>

    <select id="selectIntDomainEventList" parameterType="IntDomainEvent" resultMap="IntDomainEventResult">
        <include refid="selectIntDomainEventVo"/>
        <where>
            <if test="eventId != null and eventId != ''">
                AND event_id like concat('%', #{eventId}, '%')
            </if>
            <if test="eventType != null and eventType != ''">
                AND event_type = #{eventType}
            </if>
            <if test="aggregateType != null and aggregateType != ''">
                AND aggregate_type = #{aggregateType}
            </if>
            <if test="aggregateId != null and aggregateId != ''">
                AND aggregate_id = #{aggregateId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectIntDomainEventById" parameterType="Long" resultMap="IntDomainEventResult">
        <include refid="selectIntDomainEventVo"/>
        where id = #{id}
    </select>

    <insert id="insertIntDomainEvent" parameterType="IntDomainEvent" useGeneratedKeys="true" keyProperty="id">
        insert into int_domain_event(
            event_id,
            event_type,
            aggregate_type,
            aggregate_id,
            payload,
            trace_id,
            status,
            retry_count,
            next_retry_time,
            error_msg,
            occurred_at,
            processed_at,
            create_by, create_time
        )values(
            #{eventId},
            #{eventType},
            #{aggregateType},
            #{aggregateId},
            #{payload},
            #{traceId},
            #{status},
            #{retryCount},
            #{nextRetryTime},
            #{errorMsg},
            #{occurredAt},
            #{processedAt},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateIntDomainEvent" parameterType="IntDomainEvent">
        update int_domain_event
        <set>
            <if test="eventId != null">event_id = #{eventId},</if>
            <if test="eventType != null">event_type = #{eventType},</if>
            <if test="aggregateType != null">aggregate_type = #{aggregateType},</if>
            <if test="aggregateId != null">aggregate_id = #{aggregateId},</if>
            <if test="payload != null">payload = #{payload},</if>
            <if test="traceId != null">trace_id = #{traceId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="retryCount != null">retry_count = #{retryCount},</if>
            <if test="nextRetryTime != null">next_retry_time = #{nextRetryTime},</if>
            <if test="errorMsg != null">error_msg = #{errorMsg},</if>
            <if test="occurredAt != null">occurred_at = #{occurredAt},</if>
            <if test="processedAt != null">processed_at = #{processedAt},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteIntDomainEventById" parameterType="Long">
        delete from int_domain_event where id = #{id}
    </delete>

    <delete id="deleteIntDomainEventByIds" parameterType="Long">
        delete from int_domain_event where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
