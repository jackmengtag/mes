<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.eq.mapper.EqCommandMapper">

    <resultMap type="EqCommand" id="EqCommandResult">
        <id     property="id"    column="id"    />
        <result property="commandNo"    column="command_no"    />
        <result property="equipmentId"    column="equipment_id"    />
        <result property="equipmentCode"    column="equipment_code"    />
        <result property="commandType"    column="command_type"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="programCode"    column="program_code"    />
        <result property="params"    column="params"    />
        <result property="sendBy"    column="send_by"    />
        <result property="sendTime"    column="send_time"    />
        <result property="responseResult"    column="response_result"    />
        <result property="retryCount"    column="retry_count"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectEqCommandVo">
        select id, command_no, equipment_id, equipment_code, command_type, production_order_id, serial_no, program_code, params, send_by, send_time, response_result, retry_count, status, create_by, create_time, update_by, update_time, remark from eq_command
    </sql>

    <select id="selectEqCommandList" parameterType="EqCommand" resultMap="EqCommandResult">
        <include refid="selectEqCommandVo"/>
        <where>
            <if test="commandNo != null and commandNo != ''">
                AND command_no like concat('%', #{commandNo}, '%')
            </if>
            <if test="equipmentId != null and equipmentId != ''">
                AND equipment_id = #{equipmentId}
            </if>
            <if test="equipmentCode != null and equipmentCode != ''">
                AND equipment_code like concat('%', #{equipmentCode}, '%')
            </if>
            <if test="commandType != null and commandType != ''">
                AND command_type = #{commandType}
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="serialNo != null and serialNo != ''">
                AND serial_no like concat('%', #{serialNo}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectEqCommandById" parameterType="Long" resultMap="EqCommandResult">
        <include refid="selectEqCommandVo"/>
        where id = #{id}
    </select>

    <insert id="insertEqCommand" parameterType="EqCommand" useGeneratedKeys="true" keyProperty="id">
        insert into eq_command(
            command_no,
            equipment_id,
            equipment_code,
            command_type,
            production_order_id,
            serial_no,
            program_code,
            params,
            send_by,
            send_time,
            response_result,
            retry_count,
            status,
            create_by, create_time
        )values(
            #{commandNo},
            #{equipmentId},
            #{equipmentCode},
            #{commandType},
            #{productionOrderId},
            #{serialNo},
            #{programCode},
            #{params},
            #{sendBy},
            #{sendTime},
            #{responseResult},
            #{retryCount},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateEqCommand" parameterType="EqCommand">
        update eq_command
        <set>
            <if test="commandNo != null">command_no = #{commandNo},</if>
            <if test="equipmentId != null">equipment_id = #{equipmentId},</if>
            <if test="equipmentCode != null">equipment_code = #{equipmentCode},</if>
            <if test="commandType != null">command_type = #{commandType},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="serialNo != null">serial_no = #{serialNo},</if>
            <if test="programCode != null">program_code = #{programCode},</if>
            <if test="params != null">params = #{params},</if>
            <if test="sendBy != null">send_by = #{sendBy},</if>
            <if test="sendTime != null">send_time = #{sendTime},</if>
            <if test="responseResult != null">response_result = #{responseResult},</if>
            <if test="retryCount != null">retry_count = #{retryCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteEqCommandById" parameterType="Long">
        delete from eq_command where id = #{id}
    </delete>

    <delete id="deleteEqCommandByIds" parameterType="Long">
        delete from eq_command where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
