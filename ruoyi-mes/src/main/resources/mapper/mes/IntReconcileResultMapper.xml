<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.integration.mapper.IntReconcileResultMapper">

    <resultMap type="IntReconcileResult" id="IntReconcileResultResult">
        <id     property="id"    column="id"    />
        <result property="taskId"    column="task_id"    />
        <result property="targetSystem"    column="target_system"    />
        <result property="bizType"    column="biz_type"    />
        <result property="bizKey"    column="biz_key"    />
        <result property="diffType"    column="diff_type"    />
        <result property="mesValue"    column="mes_value"    />
        <result property="extValue"    column="ext_value"    />
        <result property="handleStatus"    column="handle_status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectIntReconcileResultVo">
        select id, task_id, target_system, biz_type, biz_key, diff_type, mes_value, ext_value, handle_status, create_by, create_time, update_by, update_time, remark from int_reconcile_result
    </sql>

    <select id="selectIntReconcileResultList" parameterType="IntReconcileResult" resultMap="IntReconcileResultResult">
        <include refid="selectIntReconcileResultVo"/>
        <where>
            <if test="taskId != null and taskId != ''">
                AND task_id = #{taskId}
            </if>
            <if test="targetSystem != null and targetSystem != ''">
                AND target_system = #{targetSystem}
            </if>
            <if test="bizType != null and bizType != ''">
                AND biz_type = #{bizType}
            </if>
            <if test="bizKey != null and bizKey != ''">
                AND biz_key like concat('%', #{bizKey}, '%')
            </if>
            <if test="diffType != null and diffType != ''">
                AND diff_type = #{diffType}
            </if>
            <if test="handleStatus != null and handleStatus != ''">
                AND handle_status = #{handleStatus}
            </if>
        </where>
    </select>

    <select id="selectIntReconcileResultById" parameterType="Long" resultMap="IntReconcileResultResult">
        <include refid="selectIntReconcileResultVo"/>
        where id = #{id}
    </select>

    <insert id="insertIntReconcileResult" parameterType="IntReconcileResult" useGeneratedKeys="true" keyProperty="id">
        insert into int_reconcile_result(
            task_id,
            target_system,
            biz_type,
            biz_key,
            diff_type,
            mes_value,
            ext_value,
            handle_status,
            create_by, create_time
        )values(
            #{taskId},
            #{targetSystem},
            #{bizType},
            #{bizKey},
            #{diffType},
            #{mesValue},
            #{extValue},
            #{handleStatus},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateIntReconcileResult" parameterType="IntReconcileResult">
        update int_reconcile_result
        <set>
            <if test="taskId != null">task_id = #{taskId},</if>
            <if test="targetSystem != null">target_system = #{targetSystem},</if>
            <if test="bizType != null">biz_type = #{bizType},</if>
            <if test="bizKey != null">biz_key = #{bizKey},</if>
            <if test="diffType != null">diff_type = #{diffType},</if>
            <if test="mesValue != null">mes_value = #{mesValue},</if>
            <if test="extValue != null">ext_value = #{extValue},</if>
            <if test="handleStatus != null">handle_status = #{handleStatus},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteIntReconcileResultById" parameterType="Long">
        delete from int_reconcile_result where id = #{id}
    </delete>

    <delete id="deleteIntReconcileResultByIds" parameterType="Long">
        delete from int_reconcile_result where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
