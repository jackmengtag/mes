<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.eq.mapper.EqAlarmMapper">

    <resultMap type="EqAlarm" id="EqAlarmResult">
        <id     property="id"    column="id"    />
        <result property="equipmentId"    column="equipment_id"    />
        <result property="equipmentCode"    column="equipment_code"    />
        <result property="alarmCode"    column="alarm_code"    />
        <result property="alarmLevel"    column="alarm_level"    />
        <result property="alarmDesc"    column="alarm_desc"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="duration"    column="duration"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectEqAlarmVo">
        select id, equipment_id, equipment_code, alarm_code, alarm_level, alarm_desc, production_order_id, operation_code, start_time, end_time, duration, create_by, create_time, update_by, update_time, remark from eq_alarm
    </sql>

    <select id="selectEqAlarmList" parameterType="EqAlarm" resultMap="EqAlarmResult">
        <include refid="selectEqAlarmVo"/>
        <where>
            <if test="equipmentId != null and equipmentId != ''">
                AND equipment_id = #{equipmentId}
            </if>
            <if test="equipmentCode != null and equipmentCode != ''">
                AND equipment_code like concat('%', #{equipmentCode}, '%')
            </if>
            <if test="alarmCode != null and alarmCode != ''">
                AND alarm_code like concat('%', #{alarmCode}, '%')
            </if>
            <if test="alarmLevel != null and alarmLevel != ''">
                AND alarm_level = #{alarmLevel}
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="operationCode != null and operationCode != ''">
                AND operation_code = #{operationCode}
            </if>
        </where>
    </select>

    <select id="selectEqAlarmById" parameterType="Long" resultMap="EqAlarmResult">
        <include refid="selectEqAlarmVo"/>
        where id = #{id}
    </select>

    <insert id="insertEqAlarm" parameterType="EqAlarm" useGeneratedKeys="true" keyProperty="id">
        insert into eq_alarm(
            equipment_id,
            equipment_code,
            alarm_code,
            alarm_level,
            alarm_desc,
            production_order_id,
            operation_code,
            start_time,
            end_time,
            duration,
            create_by, create_time
        )values(
            #{equipmentId},
            #{equipmentCode},
            #{alarmCode},
            #{alarmLevel},
            #{alarmDesc},
            #{productionOrderId},
            #{operationCode},
            #{startTime},
            #{endTime},
            #{duration},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateEqAlarm" parameterType="EqAlarm">
        update eq_alarm
        <set>
            <if test="equipmentId != null">equipment_id = #{equipmentId},</if>
            <if test="equipmentCode != null">equipment_code = #{equipmentCode},</if>
            <if test="alarmCode != null">alarm_code = #{alarmCode},</if>
            <if test="alarmLevel != null">alarm_level = #{alarmLevel},</if>
            <if test="alarmDesc != null">alarm_desc = #{alarmDesc},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="duration != null">duration = #{duration},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteEqAlarmById" parameterType="Long">
        delete from eq_alarm where id = #{id}
    </delete>

    <delete id="deleteEqAlarmByIds" parameterType="Long">
        delete from eq_alarm where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
