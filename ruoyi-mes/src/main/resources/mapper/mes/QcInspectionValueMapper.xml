<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.qc.mapper.QcInspectionValueMapper">

    <resultMap type="QcInspectionValue" id="QcInspectionValueResult">
        <id     property="id"    column="id"    />
        <result property="inspectionId"    column="inspection_id"    />
        <result property="itemCode"    column="item_code"    />
        <result property="itemName"    column="item_name"    />
        <result property="itemValue"    column="item_value"    />
        <result property="lowerLimit"    column="lower_limit"    />
        <result property="upperLimit"    column="upper_limit"    />
        <result property="result"    column="result"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectQcInspectionValueVo">
        select id, inspection_id, item_code, item_name, item_value, lower_limit, upper_limit, result, create_by, create_time, update_by, update_time, remark from qc_inspection_value
    </sql>

    <select id="selectQcInspectionValueList" parameterType="QcInspectionValue" resultMap="QcInspectionValueResult">
        <include refid="selectQcInspectionValueVo"/>
        <where>
            <if test="inspectionId != null and inspectionId != ''">
                AND inspection_id = #{inspectionId}
            </if>
            <if test="itemCode != null and itemCode != ''">
                AND item_code like concat('%', #{itemCode}, '%')
            </if>
            <if test="itemName != null and itemName != ''">
                AND item_name like concat('%', #{itemName}, '%')
            </if>
            <if test="result != null and result != ''">
                AND result = #{result}
            </if>
        </where>
    </select>

    <select id="selectQcInspectionValueById" parameterType="Long" resultMap="QcInspectionValueResult">
        <include refid="selectQcInspectionValueVo"/>
        where id = #{id}
    </select>

    <insert id="insertQcInspectionValue" parameterType="QcInspectionValue" useGeneratedKeys="true" keyProperty="id">
        insert into qc_inspection_value(
            inspection_id,
            item_code,
            item_name,
            item_value,
            lower_limit,
            upper_limit,
            result,
            create_by, create_time
        )values(
            #{inspectionId},
            #{itemCode},
            #{itemName},
            #{itemValue},
            #{lowerLimit},
            #{upperLimit},
            #{result},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateQcInspectionValue" parameterType="QcInspectionValue">
        update qc_inspection_value
        <set>
            <if test="inspectionId != null">inspection_id = #{inspectionId},</if>
            <if test="itemCode != null">item_code = #{itemCode},</if>
            <if test="itemName != null">item_name = #{itemName},</if>
            <if test="itemValue != null">item_value = #{itemValue},</if>
            <if test="lowerLimit != null">lower_limit = #{lowerLimit},</if>
            <if test="upperLimit != null">upper_limit = #{upperLimit},</if>
            <if test="result != null">result = #{result},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteQcInspectionValueById" parameterType="Long">
        delete from qc_inspection_value where id = #{id}
    </delete>

    <delete id="deleteQcInspectionValueByIds" parameterType="Long">
        delete from qc_inspection_value where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
