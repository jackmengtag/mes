<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.qc.mapper.QcReleaseMapper">

    <resultMap type="QcRelease" id="QcReleaseResult">
        <id     property="id"    column="id"    />
        <result property="releaseNo"    column="release_no"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="releaseResult"    column="release_result"    />
        <result property="releaseBy"    column="release_by"    />
        <result property="releaseTime"    column="release_time"    />
        <result property="specialFlag"    column="special_flag"    />
        <result property="blockReason"    column="block_reason"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectQcReleaseVo">
        select id, release_no, production_order_id, order_no, serial_no, release_result, release_by, release_time, special_flag, block_reason, create_by, create_time, update_by, update_time, remark from qc_release
    </sql>

    <select id="selectQcReleaseList" parameterType="QcRelease" resultMap="QcReleaseResult">
        <include refid="selectQcReleaseVo"/>
        <where>
            <if test="releaseNo != null and releaseNo != ''">
                AND release_no like concat('%', #{releaseNo}, '%')
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="serialNo != null and serialNo != ''">
                AND serial_no like concat('%', #{serialNo}, '%')
            </if>
            <if test="releaseResult != null and releaseResult != ''">
                AND release_result = #{releaseResult}
            </if>
        </where>
    </select>

    <select id="selectQcReleaseById" parameterType="Long" resultMap="QcReleaseResult">
        <include refid="selectQcReleaseVo"/>
        where id = #{id}
    </select>

    <insert id="insertQcRelease" parameterType="QcRelease" useGeneratedKeys="true" keyProperty="id">
        insert into qc_release(
            release_no,
            production_order_id,
            order_no,
            serial_no,
            release_result,
            release_by,
            release_time,
            special_flag,
            block_reason,
            create_by, create_time
        )values(
            #{releaseNo},
            #{productionOrderId},
            #{orderNo},
            #{serialNo},
            #{releaseResult},
            #{releaseBy},
            #{releaseTime},
            #{specialFlag},
            #{blockReason},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateQcRelease" parameterType="QcRelease">
        update qc_release
        <set>
            <if test="releaseNo != null">release_no = #{releaseNo},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="serialNo != null">serial_no = #{serialNo},</if>
            <if test="releaseResult != null">release_result = #{releaseResult},</if>
            <if test="releaseBy != null">release_by = #{releaseBy},</if>
            <if test="releaseTime != null">release_time = #{releaseTime},</if>
            <if test="specialFlag != null">special_flag = #{specialFlag},</if>
            <if test="blockReason != null">block_reason = #{blockReason},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteQcReleaseById" parameterType="Long">
        delete from qc_release where id = #{id}
    </delete>

    <delete id="deleteQcReleaseByIds" parameterType="Long">
        delete from qc_release where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
