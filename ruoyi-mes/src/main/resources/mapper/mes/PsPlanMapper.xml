<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.ps.mapper.PsPlanMapper">

    <resultMap type="PsPlan" id="PsPlanResult">
        <id     property="id"    column="id"    />
        <result property="planNo"    column="plan_no"    />
        <result property="demandId"    column="demand_id"    />
        <result property="demandNo"    column="demand_no"    />
        <result property="productId"    column="product_id"    />
        <result property="productCode"    column="product_code"    />
        <result property="planQty"    column="plan_qty"    />
        <result property="plannedStartTime"    column="planned_start_time"    />
        <result property="plannedEndTime"    column="planned_end_time"    />
        <result property="lineId"    column="line_id"    />
        <result property="priority"    column="priority"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectPsPlanVo">
        select id, plan_no, demand_id, demand_no, product_id, product_code, plan_qty, planned_start_time, planned_end_time, line_id, priority, status, create_by, create_time, update_by, update_time, remark from ps_plan
    </sql>

    <select id="selectPsPlanList" parameterType="PsPlan" resultMap="PsPlanResult">
        <include refid="selectPsPlanVo"/>
        <where>
            <if test="planNo != null and planNo != ''">
                AND plan_no like concat('%', #{planNo}, '%')
            </if>
            <if test="demandId != null and demandId != ''">
                AND demand_id = #{demandId}
            </if>
            <if test="demandNo != null and demandNo != ''">
                AND demand_no like concat('%', #{demandNo}, '%')
            </if>
            <if test="productId != null and productId != ''">
                AND product_id = #{productId}
            </if>
            <if test="productCode != null and productCode != ''">
                AND product_code like concat('%', #{productCode}, '%')
            </if>
            <if test="lineId != null and lineId != ''">
                AND line_id = #{lineId}
            </if>
            <if test="priority != null and priority != ''">
                AND priority = #{priority}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectPsPlanById" parameterType="Long" resultMap="PsPlanResult">
        <include refid="selectPsPlanVo"/>
        where id = #{id}
    </select>

    <insert id="insertPsPlan" parameterType="PsPlan" useGeneratedKeys="true" keyProperty="id">
        insert into ps_plan(
            plan_no,
            demand_id,
            demand_no,
            product_id,
            product_code,
            plan_qty,
            planned_start_time,
            planned_end_time,
            line_id,
            priority,
            status,
            create_by, create_time
        )values(
            #{planNo},
            #{demandId},
            #{demandNo},
            #{productId},
            #{productCode},
            #{planQty},
            #{plannedStartTime},
            #{plannedEndTime},
            #{lineId},
            #{priority},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updatePsPlan" parameterType="PsPlan">
        update ps_plan
        <set>
            <if test="planNo != null">plan_no = #{planNo},</if>
            <if test="demandId != null">demand_id = #{demandId},</if>
            <if test="demandNo != null">demand_no = #{demandNo},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="planQty != null">plan_qty = #{planQty},</if>
            <if test="plannedStartTime != null">planned_start_time = #{plannedStartTime},</if>
            <if test="plannedEndTime != null">planned_end_time = #{plannedEndTime},</if>
            <if test="lineId != null">line_id = #{lineId},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deletePsPlanById" parameterType="Long">
        delete from ps_plan where id = #{id}
    </delete>

    <delete id="deletePsPlanByIds" parameterType="Long">
        delete from ps_plan where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
