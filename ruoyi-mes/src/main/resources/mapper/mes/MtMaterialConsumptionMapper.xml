<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.mt.mapper.MtMaterialConsumptionMapper">

    <resultMap type="MtMaterialConsumption" id="MtMaterialConsumptionResult">
        <id     property="id"    column="id"    />
        <result property="consumeNo"    column="consume_no"    />
        <result property="materialId"    column="material_id"    />
        <result property="materialCode"    column="material_code"    />
        <result property="materialBatchNo"    column="material_batch_no"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="operationTaskId"    column="operation_task_id"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="consumedQty"    column="consumed_qty"    />
        <result property="substituteFlag"    column="substitute_flag"    />
        <result property="operatorNo"    column="operator_no"    />
        <result property="wmsTransactionNo"    column="wms_transaction_no"    />
        <result property="syncStatus"    column="sync_status"    />
        <result property="consumedAt"    column="consumed_at"    />
        <result property="idempotencyKey"    column="idempotency_key"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMtMaterialConsumptionVo">
        select id, consume_no, material_id, material_code, material_batch_no, production_order_id, order_no, serial_no, operation_task_id, operation_code, consumed_qty, substitute_flag, operator_no, wms_transaction_no, sync_status, consumed_at, idempotency_key, create_by, create_time, update_by, update_time, remark from mt_material_consumption
    </sql>

    <select id="selectMtMaterialConsumptionList" parameterType="MtMaterialConsumption" resultMap="MtMaterialConsumptionResult">
        <include refid="selectMtMaterialConsumptionVo"/>
        <where>
            <if test="consumeNo != null and consumeNo != ''">
                AND consume_no like concat('%', #{consumeNo}, '%')
            </if>
            <if test="materialId != null and materialId != ''">
                AND material_id = #{materialId}
            </if>
            <if test="materialCode != null and materialCode != ''">
                AND material_code like concat('%', #{materialCode}, '%')
            </if>
            <if test="materialBatchNo != null and materialBatchNo != ''">
                AND material_batch_no like concat('%', #{materialBatchNo}, '%')
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="serialNo != null and serialNo != ''">
                AND serial_no like concat('%', #{serialNo}, '%')
            </if>
            <if test="operationTaskId != null and operationTaskId != ''">
                AND operation_task_id = #{operationTaskId}
            </if>
            <if test="operationCode != null and operationCode != ''">
                AND operation_code = #{operationCode}
            </if>
            <if test="syncStatus != null and syncStatus != ''">
                AND sync_status = #{syncStatus}
            </if>
        </where>
    </select>

    <select id="selectMtMaterialConsumptionById" parameterType="Long" resultMap="MtMaterialConsumptionResult">
        <include refid="selectMtMaterialConsumptionVo"/>
        where id = #{id}
    </select>

    <insert id="insertMtMaterialConsumption" parameterType="MtMaterialConsumption" useGeneratedKeys="true" keyProperty="id">
        insert into mt_material_consumption(
            consume_no,
            material_id,
            material_code,
            material_batch_no,
            production_order_id,
            order_no,
            serial_no,
            operation_task_id,
            operation_code,
            consumed_qty,
            substitute_flag,
            operator_no,
            wms_transaction_no,
            sync_status,
            consumed_at,
            idempotency_key,
            create_by, create_time
        )values(
            #{consumeNo},
            #{materialId},
            #{materialCode},
            #{materialBatchNo},
            #{productionOrderId},
            #{orderNo},
            #{serialNo},
            #{operationTaskId},
            #{operationCode},
            #{consumedQty},
            #{substituteFlag},
            #{operatorNo},
            #{wmsTransactionNo},
            #{syncStatus},
            #{consumedAt},
            #{idempotencyKey},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMtMaterialConsumption" parameterType="MtMaterialConsumption">
        update mt_material_consumption
        <set>
            <if test="consumeNo != null">consume_no = #{consumeNo},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="materialCode != null">material_code = #{materialCode},</if>
            <if test="materialBatchNo != null">material_batch_no = #{materialBatchNo},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="serialNo != null">serial_no = #{serialNo},</if>
            <if test="operationTaskId != null">operation_task_id = #{operationTaskId},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="consumedQty != null">consumed_qty = #{consumedQty},</if>
            <if test="substituteFlag != null">substitute_flag = #{substituteFlag},</if>
            <if test="operatorNo != null">operator_no = #{operatorNo},</if>
            <if test="wmsTransactionNo != null">wms_transaction_no = #{wmsTransactionNo},</if>
            <if test="syncStatus != null">sync_status = #{syncStatus},</if>
            <if test="consumedAt != null">consumed_at = #{consumedAt},</if>
            <if test="idempotencyKey != null">idempotency_key = #{idempotencyKey},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMtMaterialConsumptionById" parameterType="Long">
        delete from mt_material_consumption where id = #{id}
    </delete>

    <delete id="deleteMtMaterialConsumptionByIds" parameterType="Long">
        delete from mt_material_consumption where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
