<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.eq.mapper.EqMaintenanceMapper">

    <resultMap type="EqMaintenance" id="EqMaintenanceResult">
        <id     property="id"    column="id"    />
        <result property="equipmentId"    column="equipment_id"    />
        <result property="equipmentCode"    column="equipment_code"    />
        <result property="maintenanceType"    column="maintenance_type"    />
        <result property="stopReason"    column="stop_reason"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="stopMinutes"    column="stop_minutes"    />
        <result property="executorNo"    column="executor_no"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectEqMaintenanceVo">
        select id, equipment_id, equipment_code, maintenance_type, stop_reason, start_time, end_time, stop_minutes, executor_no, status, create_by, create_time, update_by, update_time, remark from eq_maintenance
    </sql>

    <select id="selectEqMaintenanceList" parameterType="EqMaintenance" resultMap="EqMaintenanceResult">
        <include refid="selectEqMaintenanceVo"/>
        <where>
            <if test="equipmentId != null and equipmentId != ''">
                AND equipment_id = #{equipmentId}
            </if>
            <if test="equipmentCode != null and equipmentCode != ''">
                AND equipment_code like concat('%', #{equipmentCode}, '%')
            </if>
            <if test="maintenanceType != null and maintenanceType != ''">
                AND maintenance_type = #{maintenanceType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectEqMaintenanceById" parameterType="Long" resultMap="EqMaintenanceResult">
        <include refid="selectEqMaintenanceVo"/>
        where id = #{id}
    </select>

    <insert id="insertEqMaintenance" parameterType="EqMaintenance" useGeneratedKeys="true" keyProperty="id">
        insert into eq_maintenance(
            equipment_id,
            equipment_code,
            maintenance_type,
            stop_reason,
            start_time,
            end_time,
            stop_minutes,
            executor_no,
            status,
            create_by, create_time
        )values(
            #{equipmentId},
            #{equipmentCode},
            #{maintenanceType},
            #{stopReason},
            #{startTime},
            #{endTime},
            #{stopMinutes},
            #{executorNo},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateEqMaintenance" parameterType="EqMaintenance">
        update eq_maintenance
        <set>
            <if test="equipmentId != null">equipment_id = #{equipmentId},</if>
            <if test="equipmentCode != null">equipment_code = #{equipmentCode},</if>
            <if test="maintenanceType != null">maintenance_type = #{maintenanceType},</if>
            <if test="stopReason != null">stop_reason = #{stopReason},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="stopMinutes != null">stop_minutes = #{stopMinutes},</if>
            <if test="executorNo != null">executor_no = #{executorNo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteEqMaintenanceById" parameterType="Long">
        delete from eq_maintenance where id = #{id}
    </delete>

    <delete id="deleteEqMaintenanceByIds" parameterType="Long">
        delete from eq_maintenance where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
