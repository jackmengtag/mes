<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.md.mapper.MdBomMapper">

    <resultMap type="MdBom" id="MdBomResult">
        <id     property="id"    column="id"    />
        <result property="bomCode"    column="bom_code"    />
        <result property="productId"    column="product_id"    />
        <result property="productCode"    column="product_code"    />
        <result property="versionNo"    column="version_no"    />
        <result property="docStatus"    column="doc_status"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMdBomVo">
        select id, bom_code, product_id, product_code, version_no, doc_status, status, create_by, create_time, update_by, update_time, remark from md_bom
    </sql>

    <select id="selectMdBomList" parameterType="MdBom" resultMap="MdBomResult">
        <include refid="selectMdBomVo"/>
        <where>
            <if test="bomCode != null and bomCode != ''">
                AND bom_code like concat('%', #{bomCode}, '%')
            </if>
            <if test="productId != null and productId != ''">
                AND product_id = #{productId}
            </if>
            <if test="productCode != null and productCode != ''">
                AND product_code like concat('%', #{productCode}, '%')
            </if>
            <if test="versionNo != null and versionNo != ''">
                AND version_no like concat('%', #{versionNo}, '%')
            </if>
            <if test="docStatus != null and docStatus != ''">
                AND doc_status = #{docStatus}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectMdBomById" parameterType="Long" resultMap="MdBomResult">
        <include refid="selectMdBomVo"/>
        where id = #{id}
    </select>

    <insert id="insertMdBom" parameterType="MdBom" useGeneratedKeys="true" keyProperty="id">
        insert into md_bom(
            bom_code,
            product_id,
            product_code,
            version_no,
            doc_status,
            status,
            create_by, create_time
        )values(
            #{bomCode},
            #{productId},
            #{productCode},
            #{versionNo},
            #{docStatus},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateMdBom" parameterType="MdBom">
        update md_bom
        <set>
            <if test="bomCode != null">bom_code = #{bomCode},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="versionNo != null">version_no = #{versionNo},</if>
            <if test="docStatus != null">doc_status = #{docStatus},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteMdBomById" parameterType="Long">
        delete from md_bom where id = #{id}
    </delete>

    <delete id="deleteMdBomByIds" parameterType="Long">
        delete from md_bom where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
