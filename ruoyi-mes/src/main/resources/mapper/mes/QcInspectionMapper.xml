<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.qc.mapper.QcInspectionMapper">

    <resultMap type="QcInspection" id="QcInspectionResult">
        <id     property="id"    column="id"    />
        <result property="inspectionNo"    column="inspection_no"    />
        <result property="inspectionType"    column="inspection_type"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="operationTaskId"    column="operation_task_id"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="materialId"    column="material_id"    />
        <result property="materialBatchNo"    column="material_batch_no"    />
        <result property="inspectionPlanId"    column="inspection_plan_id"    />
        <result property="result"    column="result"    />
        <result property="inspectorNo"    column="inspector_no"    />
        <result property="inspectedAt"    column="inspected_at"    />
        <result property="releaseFlag"    column="release_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectQcInspectionVo">
        select id, inspection_no, inspection_type, production_order_id, order_no, operation_task_id, operation_code, serial_no, material_id, material_batch_no, inspection_plan_id, result, inspector_no, inspected_at, release_flag, create_by, create_time, update_by, update_time, remark from qc_inspection
    </sql>

    <select id="selectQcInspectionList" parameterType="QcInspection" resultMap="QcInspectionResult">
        <include refid="selectQcInspectionVo"/>
        <where>
            <if test="inspectionNo != null and inspectionNo != ''">
                AND inspection_no like concat('%', #{inspectionNo}, '%')
            </if>
            <if test="inspectionType != null and inspectionType != ''">
                AND inspection_type = #{inspectionType}
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="operationTaskId != null and operationTaskId != ''">
                AND operation_task_id = #{operationTaskId}
            </if>
            <if test="operationCode != null and operationCode != ''">
                AND operation_code = #{operationCode}
            </if>
            <if test="serialNo != null and serialNo != ''">
                AND serial_no like concat('%', #{serialNo}, '%')
            </if>
            <if test="materialId != null and materialId != ''">
                AND material_id = #{materialId}
            </if>
            <if test="materialBatchNo != null and materialBatchNo != ''">
                AND material_batch_no like concat('%', #{materialBatchNo}, '%')
            </if>
            <if test="result != null and result != ''">
                AND result = #{result}
            </if>
        </where>
    </select>

    <select id="selectQcInspectionById" parameterType="Long" resultMap="QcInspectionResult">
        <include refid="selectQcInspectionVo"/>
        where id = #{id}
    </select>

    <insert id="insertQcInspection" parameterType="QcInspection" useGeneratedKeys="true" keyProperty="id">
        insert into qc_inspection(
            inspection_no,
            inspection_type,
            production_order_id,
            order_no,
            operation_task_id,
            operation_code,
            serial_no,
            material_id,
            material_batch_no,
            inspection_plan_id,
            result,
            inspector_no,
            inspected_at,
            release_flag,
            create_by, create_time
        )values(
            #{inspectionNo},
            #{inspectionType},
            #{productionOrderId},
            #{orderNo},
            #{operationTaskId},
            #{operationCode},
            #{serialNo},
            #{materialId},
            #{materialBatchNo},
            #{inspectionPlanId},
            #{result},
            #{inspectorNo},
            #{inspectedAt},
            #{releaseFlag},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateQcInspection" parameterType="QcInspection">
        update qc_inspection
        <set>
            <if test="inspectionNo != null">inspection_no = #{inspectionNo},</if>
            <if test="inspectionType != null">inspection_type = #{inspectionType},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="operationTaskId != null">operation_task_id = #{operationTaskId},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="serialNo != null">serial_no = #{serialNo},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="materialBatchNo != null">material_batch_no = #{materialBatchNo},</if>
            <if test="inspectionPlanId != null">inspection_plan_id = #{inspectionPlanId},</if>
            <if test="result != null">result = #{result},</if>
            <if test="inspectorNo != null">inspector_no = #{inspectorNo},</if>
            <if test="inspectedAt != null">inspected_at = #{inspectedAt},</if>
            <if test="releaseFlag != null">release_flag = #{releaseFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteQcInspectionById" parameterType="Long">
        delete from qc_inspection where id = #{id}
    </delete>

    <delete id="deleteQcInspectionByIds" parameterType="Long">
        delete from qc_inspection where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
