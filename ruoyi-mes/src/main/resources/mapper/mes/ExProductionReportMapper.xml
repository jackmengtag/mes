<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.ex.mapper.ExProductionReportMapper">

    <resultMap type="ExProductionReport" id="ExProductionReportResult">
        <id     property="id"    column="id"    />
        <result property="reportNo"    column="report_no"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="operationTaskId"    column="operation_task_id"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="qualifiedQty"    column="qualified_qty"    />
        <result property="unqualifiedQty"    column="unqualified_qty"    />
        <result property="scrapQty"    column="scrap_qty"    />
        <result property="laborMinutes"    column="labor_minutes"    />
        <result property="machineMinutes"    column="machine_minutes"    />
        <result property="equipmentId"    column="equipment_id"    />
        <result property="operatorNo"    column="operator_no"    />
        <result property="shiftCode"    column="shift_code"    />
        <result property="reportedAt"    column="reported_at"    />
        <result property="idempotencyKey"    column="idempotency_key"    />
        <result property="syncStatus"    column="sync_status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectExProductionReportVo">
        select id, report_no, production_order_id, order_no, operation_task_id, operation_code, serial_no, qualified_qty, unqualified_qty, scrap_qty, labor_minutes, machine_minutes, equipment_id, operator_no, shift_code, reported_at, idempotency_key, sync_status, create_by, create_time, update_by, update_time, remark from ex_production_report
    </sql>

    <select id="selectExProductionReportList" parameterType="ExProductionReport" resultMap="ExProductionReportResult">
        <include refid="selectExProductionReportVo"/>
        <where>
            <if test="reportNo != null and reportNo != ''">
                AND report_no like concat('%', #{reportNo}, '%')
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="operationTaskId != null and operationTaskId != ''">
                AND operation_task_id = #{operationTaskId}
            </if>
            <if test="operationCode != null and operationCode != ''">
                AND operation_code = #{operationCode}
            </if>
            <if test="serialNo != null and serialNo != ''">
                AND serial_no like concat('%', #{serialNo}, '%')
            </if>
            <if test="equipmentId != null and equipmentId != ''">
                AND equipment_id = #{equipmentId}
            </if>
            <if test="operatorNo != null and operatorNo != ''">
                AND operator_no like concat('%', #{operatorNo}, '%')
            </if>
            <if test="syncStatus != null and syncStatus != ''">
                AND sync_status = #{syncStatus}
            </if>
        </where>
    </select>

    <select id="selectExProductionReportById" parameterType="Long" resultMap="ExProductionReportResult">
        <include refid="selectExProductionReportVo"/>
        where id = #{id}
    </select>

    <insert id="insertExProductionReport" parameterType="ExProductionReport" useGeneratedKeys="true" keyProperty="id">
        insert into ex_production_report(
            report_no,
            production_order_id,
            order_no,
            operation_task_id,
            operation_code,
            serial_no,
            qualified_qty,
            unqualified_qty,
            scrap_qty,
            labor_minutes,
            machine_minutes,
            equipment_id,
            operator_no,
            shift_code,
            reported_at,
            idempotency_key,
            sync_status,
            create_by, create_time
        )values(
            #{reportNo},
            #{productionOrderId},
            #{orderNo},
            #{operationTaskId},
            #{operationCode},
            #{serialNo},
            #{qualifiedQty},
            #{unqualifiedQty},
            #{scrapQty},
            #{laborMinutes},
            #{machineMinutes},
            #{equipmentId},
            #{operatorNo},
            #{shiftCode},
            #{reportedAt},
            #{idempotencyKey},
            #{syncStatus},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateExProductionReport" parameterType="ExProductionReport">
        update ex_production_report
        <set>
            <if test="reportNo != null">report_no = #{reportNo},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="operationTaskId != null">operation_task_id = #{operationTaskId},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="serialNo != null">serial_no = #{serialNo},</if>
            <if test="qualifiedQty != null">qualified_qty = #{qualifiedQty},</if>
            <if test="unqualifiedQty != null">unqualified_qty = #{unqualifiedQty},</if>
            <if test="scrapQty != null">scrap_qty = #{scrapQty},</if>
            <if test="laborMinutes != null">labor_minutes = #{laborMinutes},</if>
            <if test="machineMinutes != null">machine_minutes = #{machineMinutes},</if>
            <if test="equipmentId != null">equipment_id = #{equipmentId},</if>
            <if test="operatorNo != null">operator_no = #{operatorNo},</if>
            <if test="shiftCode != null">shift_code = #{shiftCode},</if>
            <if test="reportedAt != null">reported_at = #{reportedAt},</if>
            <if test="idempotencyKey != null">idempotency_key = #{idempotencyKey},</if>
            <if test="syncStatus != null">sync_status = #{syncStatus},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteExProductionReportById" parameterType="Long">
        delete from ex_production_report where id = #{id}
    </delete>

    <delete id="deleteExProductionReportByIds" parameterType="Long">
        delete from ex_production_report where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
