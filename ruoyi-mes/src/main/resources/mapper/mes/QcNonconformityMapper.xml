<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.qc.mapper.QcNonconformityMapper">

    <resultMap type="QcNonconformity" id="QcNonconformityResult">
        <id     property="id"    column="id"    />
        <result property="nonconformityNo"    column="nonconformity_no"    />
        <result property="productionOrderId"    column="production_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="operationTaskId"    column="operation_task_id"    />
        <result property="operationCode"    column="operation_code"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="defectCode"    column="defect_code"    />
        <result property="defectDesc"    column="defect_desc"    />
        <result property="discoverySource"    column="discovery_source"    />
        <result property="discoveryNo"    column="discovery_no"    />
        <result property="qty"    column="qty"    />
        <result property="disposalType"    column="disposal_type"    />
        <result property="dispositionReason"    column="disposition_reason"    />
        <result property="dispositionBy"    column="disposition_by"    />
        <result property="dispositionTime"    column="disposition_time"    />
        <result property="authorizedBy"    column="authorized_by"    />
        <result property="reinspectResult"    column="reinspect_result"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectQcNonconformityVo">
        select id, nonconformity_no, production_order_id, order_no, operation_task_id, operation_code, serial_no, defect_code, defect_desc, discovery_source, discovery_no, qty, disposal_type, disposition_reason, disposition_by, disposition_time, authorized_by, reinspect_result, status, create_by, create_time, update_by, update_time, remark from qc_nonconformity
    </sql>

    <select id="selectQcNonconformityList" parameterType="QcNonconformity" resultMap="QcNonconformityResult">
        <include refid="selectQcNonconformityVo"/>
        <where>
            <if test="nonconformityNo != null and nonconformityNo != ''">
                AND nonconformity_no like concat('%', #{nonconformityNo}, '%')
            </if>
            <if test="productionOrderId != null and productionOrderId != ''">
                AND production_order_id = #{productionOrderId}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="operationTaskId != null and operationTaskId != ''">
                AND operation_task_id = #{operationTaskId}
            </if>
            <if test="operationCode != null and operationCode != ''">
                AND operation_code = #{operationCode}
            </if>
            <if test="serialNo != null and serialNo != ''">
                AND serial_no like concat('%', #{serialNo}, '%')
            </if>
            <if test="defectCode != null and defectCode != ''">
                AND defect_code like concat('%', #{defectCode}, '%')
            </if>
            <if test="disposalType != null and disposalType != ''">
                AND disposal_type = #{disposalType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectQcNonconformityById" parameterType="Long" resultMap="QcNonconformityResult">
        <include refid="selectQcNonconformityVo"/>
        where id = #{id}
    </select>

    <insert id="insertQcNonconformity" parameterType="QcNonconformity" useGeneratedKeys="true" keyProperty="id">
        insert into qc_nonconformity(
            nonconformity_no,
            production_order_id,
            order_no,
            operation_task_id,
            operation_code,
            serial_no,
            defect_code,
            defect_desc,
            discovery_source,
            discovery_no,
            qty,
            disposal_type,
            disposition_reason,
            disposition_by,
            disposition_time,
            authorized_by,
            reinspect_result,
            status,
            create_by, create_time
        )values(
            #{nonconformityNo},
            #{productionOrderId},
            #{orderNo},
            #{operationTaskId},
            #{operationCode},
            #{serialNo},
            #{defectCode},
            #{defectDesc},
            #{discoverySource},
            #{discoveryNo},
            #{qty},
            #{disposalType},
            #{dispositionReason},
            #{dispositionBy},
            #{dispositionTime},
            #{authorizedBy},
            #{reinspectResult},
            #{status},
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updateQcNonconformity" parameterType="QcNonconformity">
        update qc_nonconformity
        <set>
            <if test="nonconformityNo != null">nonconformity_no = #{nonconformityNo},</if>
            <if test="productionOrderId != null">production_order_id = #{productionOrderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="operationTaskId != null">operation_task_id = #{operationTaskId},</if>
            <if test="operationCode != null">operation_code = #{operationCode},</if>
            <if test="serialNo != null">serial_no = #{serialNo},</if>
            <if test="defectCode != null">defect_code = #{defectCode},</if>
            <if test="defectDesc != null">defect_desc = #{defectDesc},</if>
            <if test="discoverySource != null">discovery_source = #{discoverySource},</if>
            <if test="discoveryNo != null">discovery_no = #{discoveryNo},</if>
            <if test="qty != null">qty = #{qty},</if>
            <if test="disposalType != null">disposal_type = #{disposalType},</if>
            <if test="dispositionReason != null">disposition_reason = #{dispositionReason},</if>
            <if test="dispositionBy != null">disposition_by = #{dispositionBy},</if>
            <if test="dispositionTime != null">disposition_time = #{dispositionTime},</if>
            <if test="authorizedBy != null">authorized_by = #{authorizedBy},</if>
            <if test="reinspectResult != null">reinspect_result = #{reinspectResult},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteQcNonconformityById" parameterType="Long">
        delete from qc_nonconformity where id = #{id}
    </delete>

    <delete id="deleteQcNonconformityByIds" parameterType="Long">
        delete from qc_nonconformity where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
