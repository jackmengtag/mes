    <sql id="selectMesWorkOrderVo">
        select work_order_id,
               order_code,
               plan_code,
               product_code,
               product_name,
               qty,
               completed_qty,
               ng_qty,
               unit,
               line_code,
               station,
               status,
               priority,
               plan_start,
               plan_end,
               source_order,
               remark,
               create_by,
               create_time,
               update_by,
