    <sql id="selectMesSalesOrderVo">
        select sales_id,
               order_code,
               customer_code,
               customer_name,
               product_code,
               product_name,
               qty,
               shipped_qty,
               price,
               amount,
               status,
               order_date,
               delivery_date,
               remark,
               create_by,
               create_time,
               update_by,
               update_time from mes_sales_order
    </sql>

    <select id="selectMesSalesOrderList" parameterType="com.ruoyi.mes.domain.MesSalesOrder" resultMap="MesSalesOrderResult">
        <include refid="selectMesSalesOrderVo"/>
        <where>
            <if test="status != null and status != ''"> AND status = #{status}</if>
            <if test="customerCode != null and customerCode != ''"> AND customer_code = #{customerCode}</if>
            <if test="params.keyword != null and params.keyword != ''">
                AND (1 = 0
            <if test="params.keyword != null and params.keyword != ''"> OR order_code like concat('%', #{params.keyword}, '%')</if>
            <if test="params.keyword != null and params.keyword != ''"> OR customer_name like concat('%', #{params.keyword}, '%')</if>
            <if test="params.keyword != null and params.keyword != ''"> OR product_code like concat('%', #{params.keyword}, '%')</if>
            <if test="params.keyword != null and params.keyword != ''"> OR product_name like concat('%', #{params.keyword}, '%')</if>
                )
            </if>
        </where>
        order by sales_id desc
    </select>

    <select id="selectMesSalesOrderById" parameterType="Long" resultMap="MesSalesOrderResult">
        <include refid="selectMesSalesOrderVo"/>
        where sales_id = #{salesId}
    </select>

    <insert id="insertMesSalesOrder" parameterType="com.ruoyi.mes.domain.MesSalesOrder" useGeneratedKeys="true" keyProperty="salesId">
