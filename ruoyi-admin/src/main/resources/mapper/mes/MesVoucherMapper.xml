<mapper namespace="com.ruoyi.mes.mapper.MesVoucherMapper">

    <resultMap type="com.ruoyi.mes.domain.MesVoucher" id="MesVoucherResult">
        <result property="voucherId"    column="voucher_id"    />
        <result property="voucherCode"    column="voucher_code"    />
        <result property="bizType"    column="biz_type"    />
        <result property="bizCode"    column="biz_code"    />
        <result property="qty"    column="qty"    />
        <result property="amount"    column="amount"    />
        <result property="accountPeriod"    column="account_period"    />
        <result property="status"    column="status"    />
        <result property="u8cStatus"    column="u8c_status"    />
        <result property="syncTime"    column="sync_time"    />
        <result property="message"    column="message"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
