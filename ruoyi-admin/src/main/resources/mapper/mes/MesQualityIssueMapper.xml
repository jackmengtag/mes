<mapper namespace="com.ruoyi.mes.mapper.MesQualityIssueMapper">

    <resultMap type="com.ruoyi.mes.domain.MesQualityIssue" id="MesQualityIssueResult">
        <result property="issueId"    column="issue_id"    />
        <result property="issueCode"    column="issue_code"    />
        <result property="sourceType"    column="source_type"    />
        <result property="sourceCode"    column="source_code"    />
        <result property="productCode"    column="product_code"    />
        <result property="batchNo"    column="batch_no"    />
        <result property="serialNo"    column="serial_no"    />
        <result property="issueType"    column="issue_type"    />
        <result property="severity"    column="severity"    />
        <result property="qty"    column="qty"    />
        <result property="description"    column="description"    />
        <result property="dispose"    column="dispose"    />
        <result property="status"    column="status"    />
        <result property="handler"    column="handler"    />
        <result property="foundTime"    column="found_time"    />
        <result property="closeTime"    column="close_time"    />
