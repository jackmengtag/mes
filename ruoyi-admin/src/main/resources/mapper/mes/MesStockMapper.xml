<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.mapper.MesStockMapper">

    <resultMap type="com.ruoyi.mes.domain.MesStock" id="MesStockResult">
        <result property="stockId"    column="stock_id"    />
        <result property="materialCode"    column="material_code"    />
        <result property="materialName"    column="material_name"    />
        <result property="spec"    column="spec"    />
        <result property="unit"    column="unit"    />
        <result property="warehouseCode"    column="warehouse_code"    />
        <result property="warehouseName"    column="warehouse_name"    />
        <result property="batchNo"    column="batch_no"    />
        <result property="qty"    column="qty"    />
        <result property="lockedQty"    column="locked_qty"    />
        <result property="safetyQty"    column="safety_qty"    />
        <result property="price"    column="price"    />
        <result property="amount"    column="amount"    />
        <result property="location"    column="location"    />
        <result property="status"    column="status"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMesStockVo">
        select stock_id,
               material_code,
               material_name,
               spec,
               unit,
               warehouse_code,
               warehouse_name,
               batch_no,
               qty,
               locked_qty,
               safety_qty,
               price,
               amount,
               location,
               status,
               update_time from mes_stock
    </sql>

    <select id="selectMesStockList" parameterType="com.ruoyi.mes.domain.MesStock" resultMap="MesStockResult">
        <include refid="selectMesStockVo"/>
        <where>
            <if test="status != null and status != ''"> AND status = #{status}</if>
            <if test="warehouseCode != null and warehouseCode != ''"> AND warehouse_code = #{warehouseCode}</if>
            <if test="params.keyword != null and params.keyword != ''">
                AND (1 = 0
            <if test="params.keyword != null and params.keyword != ''"> OR material_code like concat('%', #{params.keyword}, '%')</if>
            <if test="params.keyword != null and params.keyword != ''"> OR material_name like concat('%', #{params.keyword}, '%')</if>
            <if test="params.keyword != null and params.keyword != ''"> OR batch_no like concat('%', #{params.keyword}, '%')</if>
                )
            </if>
        </where>
        order by stock_id desc
    </select>

    <select id="selectMesStockById" parameterType="Long" resultMap="MesStockResult">
        <include refid="selectMesStockVo"/>
        where stock_id = #{stockId}
    </select>

    <insert id="insertMesStock" parameterType="com.ruoyi.mes.domain.MesStock" useGeneratedKeys="true" keyProperty="stockId">
        insert into mes_stock
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="materialCode != null">material_code,</if>
            <if test="materialName != null">material_name,</if>
            <if test="spec != null">spec,</if>
            <if test="unit != null">unit,</if>
            <if test="warehouseCode != null">warehouse_code,</if>
            <if test="warehouseName != null">warehouse_name,</if>
            <if test="batchNo != null">batch_no,</if>
            <if test="qty != null">qty,</if>
            <if test="lockedQty != null">locked_qty,</if>
            <if test="safetyQty != null">safety_qty,</if>
            <if test="price != null">price,</if>
            <if test="amount != null">amount,</if>
            <if test="location != null">location,</if>
            <if test="status != null">status,</if>

            
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="materialCode != null">#{materialCode},</if>
            <if test="materialName != null">#{materialName},</if>
            <if test="spec != null">#{spec},</if>
            <if test="unit != null">#{unit},</if>
            <if test="warehouseCode != null">#{warehouseCode},</if>
            <if test="warehouseName != null">#{warehouseName},</if>
            <if test="batchNo != null">#{batchNo},</if>
            <if test="qty != null">#{qty},</if>
            <if test="lockedQty != null">#{lockedQty},</if>
            <if test="safetyQty != null">#{safetyQty},</if>
            <if test="price != null">#{price},</if>
            <if test="amount != null">#{amount},</if>
            <if test="location != null">#{location},</if>
            <if test="status != null">#{status},</if>

            
        </trim>
    </insert>

    <update id="updateMesStock" parameterType="com.ruoyi.mes.domain.MesStock">
        update mes_stock
        <trim prefix="SET" suffixOverrides=",">
            <if test="materialCode != null">material_code = #{materialCode},</if>
            <if test="materialName != null">material_name = #{materialName},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="warehouseCode != null">warehouse_code = #{warehouseCode},</if>
            <if test="warehouseName != null">warehouse_name = #{warehouseName},</if>
            <if test="batchNo != null">batch_no = #{batchNo},</if>
            <if test="qty != null">qty = #{qty},</if>
            <if test="lockedQty != null">locked_qty = #{lockedQty},</if>
            <if test="safetyQty != null">safety_qty = #{safetyQty},</if>
            <if test="price != null">price = #{price},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="location != null">location = #{location},</if>
            <if test="status != null">status = #{status},</if>

            update_time = sysdate(),
        </trim>
        where stock_id = #{stockId}
    </update>

    <delete id="deleteMesStockById" parameterType="Long">
        delete from mes_stock where stock_id = #{stockId}
    </delete>

    <delete id="deleteMesStockByIds" parameterType="String">
        delete from mes_stock where stock_id in
        <foreach item="stockId" collection="array" open="(" separator="," close=")">
            #{stockId}
        </foreach>
    </delete>
</mapper>
