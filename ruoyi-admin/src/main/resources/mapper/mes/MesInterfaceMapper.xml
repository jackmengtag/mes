<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.mapper.MesInterfaceMapper">

    <resultMap type="com.ruoyi.mes.domain.MesInterface" id="MesInterfaceResult">
        <result property="interfaceId"    column="interface_id"    />
        <result property="interfaceCode"    column="interface_code"    />
        <result property="interfaceName"    column="interface_name"    />
        <result property="targetSystem"    column="target_system"    />
        <result property="status"    column="status"    />
        <result property="lastSync"    column="last_sync"    />
        <result property="successRate"    column="success_rate"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMesInterfaceVo">
        select interface_id,
               interface_code,
               interface_name,
               target_system,
               status,
               last_sync,
               success_rate,
               remark,
               create_by,
               create_time,
               update_by,
               update_time from mes_interface
    </sql>

    <select id="selectMesInterfaceList" parameterType="com.ruoyi.mes.domain.MesInterface" resultMap="MesInterfaceResult">
        <include refid="selectMesInterfaceVo"/>
        <where>
            <if test="status != null and status != ''"> AND status = #{status}</if>
            <if test="targetSystem != null and targetSystem != ''"> AND target_system = #{targetSystem}</if>
            <if test="params.keyword != null and params.keyword != ''">
                AND (1 = 0
            <if test="params.keyword != null and params.keyword != ''"> OR interface_code like concat('%', #{params.keyword}, '%')</if>
            <if test="params.keyword != null and params.keyword != ''"> OR interface_name like concat('%', #{params.keyword}, '%')</if>
                )
            </if>
        </where>
        order by interface_id desc
    </select>

    <select id="selectMesInterfaceById" parameterType="Long" resultMap="MesInterfaceResult">
        <include refid="selectMesInterfaceVo"/>
        where interface_id = #{interfaceId}
    </select>

    <insert id="insertMesInterface" parameterType="com.ruoyi.mes.domain.MesInterface" useGeneratedKeys="true" keyProperty="interfaceId">
        insert into mes_interface
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="interfaceCode != null">interface_code,</if>
            <if test="interfaceName != null">interface_name,</if>
            <if test="targetSystem != null">target_system,</if>
            <if test="status != null">status,</if>
            <if test="lastSync != null">last_sync,</if>
            <if test="successRate != null">success_rate,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="interfaceCode != null">#{interfaceCode},</if>
            <if test="interfaceName != null">#{interfaceName},</if>
            <if test="targetSystem != null">#{targetSystem},</if>
            <if test="status != null">#{status},</if>
            <if test="lastSync != null">#{lastSync},</if>
            <if test="successRate != null">#{successRate},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateMesInterface" parameterType="com.ruoyi.mes.domain.MesInterface">
        update mes_interface
        <trim prefix="SET" suffixOverrides=",">
            <if test="interfaceCode != null">interface_code = #{interfaceCode},</if>
            <if test="interfaceName != null">interface_name = #{interfaceName},</if>
            <if test="targetSystem != null">target_system = #{targetSystem},</if>
            <if test="status != null">status = #{status},</if>
            <if test="lastSync != null">last_sync = #{lastSync},</if>
            <if test="successRate != null">success_rate = #{successRate},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate(),
        </trim>
        where interface_id = #{interfaceId}
    </update>

    <delete id="deleteMesInterfaceById" parameterType="Long">
        delete from mes_interface where interface_id = #{interfaceId}
    </delete>

    <delete id="deleteMesInterfaceByIds" parameterType="String">
        delete from mes_interface where interface_id in
        <foreach item="interfaceId" collection="array" open="(" separator="," close=")">
            #{interfaceId}
        </foreach>
    </delete>
</mapper>
