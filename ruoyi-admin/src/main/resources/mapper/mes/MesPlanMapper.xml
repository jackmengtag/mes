<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.mapper.MesPlanMapper">

    <resultMap type="com.ruoyi.mes.domain.MesPlan" id="MesPlanResult">
        <result property="planId"    column="plan_id"    />
        <result property="planCode"    column="plan_code"    />
        <result property="planType"    column="plan_type"    />
        <result property="planMonth"    column="plan_month"    />
        <result property="productCode"    column="product_code"    />
        <result property="productName"    column="product_name"    />
        <result property="qty"    column="qty"    />
        <result property="unit"    column="unit"    />
        <result property="lineCode"    column="line_code"    />
        <result property="status"    column="status"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="sourceCode"    column="source_code"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMesPlanVo">
        select plan_id,
               plan_code,
               plan_type,
               plan_month,
               product_code,
               product_name,
               qty,
               unit,
               line_code,
               status,
               start_date,
               end_date,
               source_code,
               remark,
               create_by,
               create_time,
               update_by,
               update_time from mes_plan
    </sql>

    <select id="selectMesPlanList" parameterType="com.ruoyi.mes.domain.MesPlan" resultMap="MesPlanResult">
        <include refid="selectMesPlanVo"/>
        <where>
            <if test="planType != null and planType != ''"> AND plan_type = #{planType}</if>
            <if test="status != null and status != ''"> AND status = #{status}</if>
            <if test="planMonth != null and planMonth != ''"> AND plan_month = #{planMonth}</if>
            <if test="lineCode != null and lineCode != ''"> AND line_code = #{lineCode}</if>
            <if test="params.keyword != null and params.keyword != ''">
                AND (1 = 0
            <if test="params.keyword != null and params.keyword != ''"> OR plan_code like concat('%', #{params.keyword}, '%')</if>
            <if test="params.keyword != null and params.keyword != ''"> OR product_code like concat('%', #{params.keyword}, '%')</if>
            <if test="params.keyword != null and params.keyword != ''"> OR product_name like concat('%', #{params.keyword}, '%')</if>
                )
            </if>
        </where>
        order by plan_id desc
    </select>

    <select id="selectMesPlanById" parameterType="Long" resultMap="MesPlanResult">
        <include refid="selectMesPlanVo"/>
        where plan_id = #{planId}
    </select>

    <insert id="insertMesPlan" parameterType="com.ruoyi.mes.domain.MesPlan" useGeneratedKeys="true" keyProperty="planId">
        insert into mes_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planCode != null">plan_code,</if>
            <if test="planType != null">plan_type,</if>
            <if test="planMonth != null">plan_month,</if>
            <if test="productCode != null">product_code,</if>
            <if test="productName != null">product_name,</if>
            <if test="qty != null">qty,</if>
            <if test="unit != null">unit,</if>
            <if test="lineCode != null">line_code,</if>
            <if test="status != null">status,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="sourceCode != null">source_code,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planCode != null">#{planCode},</if>
            <if test="planType != null">#{planType},</if>
            <if test="planMonth != null">#{planMonth},</if>
            <if test="productCode != null">#{productCode},</if>
            <if test="productName != null">#{productName},</if>
            <if test="qty != null">#{qty},</if>
            <if test="unit != null">#{unit},</if>
            <if test="lineCode != null">#{lineCode},</if>
            <if test="status != null">#{status},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="sourceCode != null">#{sourceCode},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateMesPlan" parameterType="com.ruoyi.mes.domain.MesPlan">
        update mes_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="planCode != null">plan_code = #{planCode},</if>
            <if test="planType != null">plan_type = #{planType},</if>
            <if test="planMonth != null">plan_month = #{planMonth},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="qty != null">qty = #{qty},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="lineCode != null">line_code = #{lineCode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="sourceCode != null">source_code = #{sourceCode},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate(),
        </trim>
        where plan_id = #{planId}
    </update>

    <delete id="deleteMesPlanById" parameterType="Long">
        delete from mes_plan where plan_id = #{planId}
    </delete>

    <delete id="deleteMesPlanByIds" parameterType="String">
        delete from mes_plan where plan_id in
        <foreach item="planId" collection="array" open="(" separator="," close=")">
            #{planId}
        </foreach>
    </delete>
</mapper>
